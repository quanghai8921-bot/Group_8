    {
      "name": "Reviews",
      "item": [
        {
          "name": "Submit Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('✓ Review submitted successfully');",
                  "    console.log('Review ID: ' + jsonData.reviewId);",
                  "    console.log('Rating: ' + jsonData.rating);",
                  "} else {",
                  "    console.log('✗ Failed to submit review');",
                  "    console.log('Note: Order must be completed (status = 4)');",
                  "    console.log(pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
