    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Verify required variables",
                  "if (!pm.collectionVariables.get('authToken')) {",
                  "    console.warn('⚠️ authToken not set');",
                  "}",
                  "if (!pm.collectionVariables.get('userId')) {",
                  "    console.warn('⚠️ userId not set');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('orderId', jsonData.orderId);",
                  "    pm.environment.set('orderId', jsonData.orderId);",
                  "    console.log('✓ Order placed successfully');",
                  "    console.log('Order ID: ' + jsonData.orderId);",
                  "    console.log('Total Amount: ' + jsonData.totalAmount);",
                  "} else {",
                  "    console.log('✗ Failed to place order');",
                  "    console.log(pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
