    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('userId', jsonData.userId);",
                  "    pm.environment.set('userId', jsonData.userId);",
                  "    console.log('✓ User registered successfully');",
                  "    console.log('User ID: ' + jsonData.userId);",
                  "} else {",
                  "    console.log('✗ Registration failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phoneNumber\": \"0912345678\",\n  \"birthDate\": \"1990-05-15\"\n}"
            },
            "url": {
              "raw": "http://localhost:4040/api/users/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4040",
              "path": [
                "api",
                "users",
                "register"
              ]
            },
            "description": "Register a new user account with email and password"
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    pm.environment.set('authToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.userId);",
                  "    pm.environment.set('userId', jsonData.userId);",
                  "    console.log('✓ Login successful');",
                  "    console.log('Token: ' + jsonData.token.substring(0, 20) + '...');",
                  "} else {",
                  "    console.log('✗ Login failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:4040/api/users/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4040",
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "Authenticate with email and password to get JWT token"
          },
          "response": []
        }
      ]
    },
