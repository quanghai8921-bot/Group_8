    {
      "name": "Shopping Cart",
      "item": [
        {
          "name": "Add to Cart",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Make sure you have authToken and userId set before running this",
                  "if (!pm.collectionVariables.get('authToken')) {",
                  "    console.warn('⚠️ authToken not set. Run Login endpoint first!');",
                  "}",
                  "if (!pm.collectionVariables.get('userId')) {",
                  "    console.warn('⚠️ userId not set. Run Register or Login endpoint first!');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('✓ Item added to cart');",
                  "    console.log('Total Price: ' + jsonData.totalPrice);",
                  "} else {",
                  "    console.log('✗ Failed to add item');",
                  "    console.log(pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"foodId\": \"FOOD001\",\n  \"quantity\": 2,\n  \"toppingIds\": [\n    \"TOP001\",\n    \"TOP002\"\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:4040/api/carts/add-item",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4040",
              "path": [
                "api",
                "carts",
                "add-item"
              ]
            },
            "description": "Add a food item to user's shopping cart. Requires authentication token."
          },
          "response": []
        },
