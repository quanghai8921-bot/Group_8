Viết module Import xlsx to DB sql, hãy đảm bảo khi đọc file xlsx sẽ check xem thứ tự insert như thế nào để tránh lỗi khóa ngoại trong sql, chỉ những cột nào đang là tiếng việt có dấu thì thêm chữ N phía trước N'text'Create database ShopeeFood



CREATE TABLE [User](

[User_ID] varchar(10) PRIMARY KEY,

Full_Name nvarchar(50) NOT NULL,

Birth_Date DATE NOT NULL,

Phone_Number varchar(10) UNIQUE NOT NULL,

Email varchar(50) UNIQUE NOT NULL,

Passwords varchar(30) NOT NULL,

Address_Delivery nvarchar(100) NOT NULL,

Shopee_Coins int DEFAULT 0 CONSTRAINT CK_coins_positive CHECK (Shopee_Coins >= 0)

);



CREATE TABLE [Role](

Role_ID varchar(10) PRIMARY KEY,

Role_Name nvarchar(50) NOT NULL

);



CREATE TABLE User_Role_Mapping(

[User_ID] varchar(10) NOT NULL,

[Role_ID] varchar(10) NOT NULL,

Assigned_Date DATETIME, 

PRIMARY KEY ([User_ID], [Role_ID]),

CONSTRAINT FK_URM_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID]),

CONSTRAINT FK_URM_Role FOREIGN KEY ([Role_ID]) REFERENCES [Role](Role_ID)

);



CREATE TABLE Merchant(

Merchant_ID varchar(10) PRIMARY KEY,

[User_ID] varchar(10) NOT NULL UNIQUE,

Store_Name nvarchar(100) NOT NULL,

Store_Address nvarchar(100) NOT NULL,

Open_Time time NOT NULL, 

Close_Time time NOT NULL, 

Active_Status tinyint NOT NULL,

Shop_Type nvarchar(50) NOT NULL,

Rating tinyint DEFAULT 5 CONSTRAINT CK_Merchant_Rating CHECK (Rating BETWEEN 1 AND 5),

CONSTRAINT FK_Merchant_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID])

);



CREATE TABLE Driver(

Driver_ID varchar(10) PRIMARY KEY,

[User_ID] varchar(10) NOT NULL UNIQUE,

Full_Name nvarchar(50) NOT NULL,

Birth_Date DATE NOT NULL,

Phone_Number varchar(10) UNIQUE NOT NULL,

LicensePlate varchar(15) NOT NULL,

Vehicle_Type nvarchar(50) NULL,

Is_Verified BIT DEFAULT 0,

CONSTRAINT FK_Driver_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID])

);



CREATE TABLE Driver_Location(

Driver_ID VARCHAR(10) PRIMARY KEY,

Latitude DECIMAL(9,6),

Longitude DECIMAL(9,6),

Updated_At DATETIME,

Is_Active BIT DEFAULT 0,

CONSTRAINT FK_Location_Driver FOREIGN KEY (Driver_ID) REFERENCES Driver(Driver_ID)

);



CREATE TABLE Menu_Category(

Category_ID varchar(10) PRIMARY KEY,

Merchant_ID varchar(10) NOT NULL,

Name_Category nvarchar(50) NOT NULL,

CONSTRAINT FK_Category_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID)

);



CREATE TABLE Food_Item(

Food_ID varchar(10) PRIMARY KEY,

Category_ID varchar(10) NOT NULL, 

Food_Name nvarchar(50) NOT NULL,

Original_Price DECIMAL(18, 0) CONSTRAINT CK_Original_Price CHECK (Original_Price >= 0),

Sale_Price DECIMAL(18, 0) CONSTRAINT CK_Sale_Price CHECK (Sale_Price >= 0),

Food_Image VARCHAR(255),

Descriptions nvarchar(255),

Status_Food nvarchar(20) NOT NULL,

CONSTRAINT FK_Food_Category FOREIGN KEY (Category_ID) REFERENCES Menu_Category(Category_ID)

);



CREATE TABLE Option_Topping(

Topping_ID varchar(10) PRIMARY KEY,

Merchant_ID varchar(10) NOT NULL,

Name_Option nvarchar(50),

Surcharge DECIMAL(18, 0) CONSTRAINT CK_Surcharge CHECK (Surcharge >= 0),

CONSTRAINT FK_Topping_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID)

);



CREATE TABLE Food_Topping_Mapping (

Mapping_ID varchar(10) PRIMARY KEY,

Food_ID varchar(10) NOT NULL,

Topping_ID varchar(10) NOT NULL,

CONSTRAINT FK_Mapping_Food FOREIGN KEY (Food_ID) REFERENCES Food_Item(Food_ID),

CONSTRAINT FK_Mapping_Topping FOREIGN KEY (Topping_ID) REFERENCES Option_Topping(Topping_ID),

CONSTRAINT UC_Food_Topping UNIQUE (Food_ID, Topping_ID)

);



CREATE TABLE Cart (

Cart_ID VARCHAR(10) PRIMARY KEY,

[User_ID] VARCHAR(10) NOT NULL,

Merchant_ID VARCHAR(10) NOT NULL,

Create_At DATETIME,

Subtotal_Price DECIMAL(18, 0) CONSTRAINT CK_Subtotal_Min CHECK (Subtotal_Price >= 0),

CONSTRAINT FK_Cart_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID]),

CONSTRAINT FK_Cart_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID)

);



CREATE TABLE Cart_Item (

Cart_Item_ID VARCHAR(10) PRIMARY KEY,

Cart_ID VARCHAR(10) NOT NULL,

Food_ID VARCHAR(10) NOT NULL,

Quantity INT NOT NULL CONSTRAINT CK_Cart_Quantity_Min CHECK (Quantity > 0),

Note NVARCHAR(255) null,

CONSTRAINT FK_CartItem_Cart FOREIGN KEY (Cart_ID) REFERENCES Cart(Cart_ID),

CONSTRAINT FK_CartItem_Food FOREIGN KEY (Food_ID) REFERENCES Food_Item(Food_ID)

);



CREATE TABLE Cart_Item_Topping (

Cart_Topping_ID VARCHAR(10) PRIMARY KEY,

Cart_Item_ID VARCHAR(10) NOT NULL,

Topping_ID VARCHAR(10) NOT NULL,

CONSTRAINT FK_CartTopping_Item FOREIGN KEY (Cart_Item_ID) REFERENCES Cart_Item(Cart_Item_ID),

CONSTRAINT FK_CartTopping_Topping FOREIGN KEY (Topping_ID) REFERENCES Option_Topping(Topping_ID)

);



CREATE TABLE Voucher (

Voucher_ID INT IDENTITY(1,1) PRIMARY KEY,

Voucher_Code VARCHAR(20) NOT NULL UNIQUE, 

Voucher_Type NVARCHAR(50), 

Discount_Value DECIMAL(18,0) NOT NULL, 

Min_Order_Value DECIMAL(18,0) DEFAULT 0, 

Max_Usage INT DEFAULT 1, 

[Start_Date] DATETIME,

End_Date DATETIME,

CONSTRAINT CK_Voucher_Value CHECK (Discount_Value >= 0)

);



CREATE TABLE [Order] (

Order_ID varchar(10) PRIMARY KEY,

[User_ID] VARCHAR(10) NOT NULL,

Merchant_ID VARCHAR(10) NOT NULL,

Driver_ID VARCHAR(10) NULL,

Voucher_ID INT NULL, 

Order_Time DATETIME,

Pickup_Time DATETIME NULL,

Delivery_Time DATETIME NULL,

Food_Amount DECIMAL(18,0) NOT NULL,

Shipping_Fee DECIMAL(18,0) NOT NULL,

Discount_Amount DECIMAL(18,0) DEFAULT 0,

Final_Amount AS (Food_Amount + Shipping_Fee - Discount_Amount),

[Status] TINYINT DEFAULT 1,

Delivery_Address NVARCHAR(255) NOT NULL,

CONSTRAINT FK_Order_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID]),

CONSTRAINT FK_Order_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID),

CONSTRAINT FK_Order_Voucher FOREIGN KEY (Voucher_ID) REFERENCES Voucher(Voucher_ID),

CONSTRAINT FK_Order_Driver FOREIGN KEY (Driver_ID) REFERENCES Driver(Driver_ID)

);



CREATE TABLE Order_Detail (

Order_Detail_ID varchar(10) PRIMARY KEY,

Order_ID varchar(10) NOT NULL,

Food_ID varchar(10) NOT NULL, 

Food_Name NVARCHAR(100) NOT NULL,

Quantity INT NOT NULL CHECK (Quantity > 0),

Unit_Price DECIMAL(18,0) NOT NULL,

CONSTRAINT FK_Detail_Order FOREIGN KEY (Order_ID) REFERENCES [Order](Order_ID),

CONSTRAINT FK_Detail_Food FOREIGN KEY (Food_ID) REFERENCES Food_Item(Food_ID)

);



CREATE TABLE Order_Detail_Topping (

OD_Topping_ID varchar(10) PRIMARY KEY,

Order_Detail_ID varchar(10) NOT NULL,

Topping_Name NVARCHAR(100) NOT NULL,

Topping_Price DECIMAL(18,0) NOT NULL,

CONSTRAINT FK_ODT_Detail FOREIGN KEY (Order_Detail_ID) REFERENCES Order_Detail(Order_Detail_ID)

);



CREATE TABLE Payment (

Payment_ID varchar(10) PRIMARY KEY,

Order_ID varchar(10) NOT NULL UNIQUE, 

Amount DECIMAL(18,0) NOT NULL,

Payment_Method NVARCHAR(50), 

Payment_Date DATETIME,

[Status] NVARCHAR(20),

CONSTRAINT FK_Payment_Order FOREIGN KEY (Order_ID) REFERENCES [Order](Order_ID)

);



CREATE TABLE Review (

Review_ID varchar(10) PRIMARY KEY,

Order_ID varchar(10) NOT NULL,

Rating TINYINT CHECK (Rating BETWEEN 1 AND 5),

Comment NVARCHAR(MAX),

Review_Type NVARCHAR(50),

Media_URL VARCHAR(255) null, 

CreatedAt DATETIME,

CONSTRAINT FK_Review_Order FOREIGN KEY (Order_ID) REFERENCES [Order](Order_ID)

);

Chào bạn, đây là một yêu cầu rất thực tế khi triển khai dữ liệu (Data Migration). Để giải quyết bài toán này, chúng ta cần một script Python xử lý được 3 vấn đề chính:

Thứ tự Insert (Dependency Order): Phải nhập bảng cha (Primary Key) trước rồi mới đến bảng con (Foreign Key).

Xử lý Unicode (N'text'): Tự động nhận diện cột nào cần thêm tiền tố N để lưu tiếng Việt không bị lỗi font.

Xử lý dữ liệu rỗng và ngày tháng: Chuyển NaN của Excel thành NULL của SQL và định dạng ngày tháng chuẩn.

Dưới đây là module Python hoàn chỉnh sử dụng thư viện pandas (đọc Excel) và pyodbc (kết nối SQL Server).

Cài đặt thư viện cần thiết
Trước khi chạy, bạn cần cài các thư viện sau:

Bash
pip install pandas openpyxl pyodbc
Module Python: Import Excel to SQL Server
Bạn hãy lưu code này vào file import_data.py.

Python
import pandas as pd
import pyodbc
import numpy as np

# --- CẤU HÌNH KẾT NỐI ---
DB_CONFIG = {
    'server': 'DESKTOP-NAME\\SQLEXPRESS',  # Thay tên Server của bạn
    'database': 'ShopeeFood',
    'driver': '{ODBC Driver 17 for SQL Server}', # Hoặc ODBC Driver 18/SQL Server Native Client...
    'trusted_connection': 'yes' # Dùng Windows Authentication
}

# --- CẤU HÌNH FILE EXCEL ---
EXCEL_FILE = 'ShopeeFood_Full_Data.xlsx'

# --- 1. ĐỊNH NGHĨA THỨ TỰ INSERT ĐỂ TRÁNH LỖI KHÓA NGOẠI (FK) ---
# Logic: Bảng không có FK hoặc FK trỏ đến bảng đã có thì xếp trước.
TABLE_ORDER = [
    "Role",                 # Độc lập
    "User",                 # Độc lập
    "User_Role_Mapping",    # Phụ thuộc User, Role
    "Merchant",             # Phụ thuộc User
    "Driver",               # Phụ thuộc User
    "Driver_Location",      # Phụ thuộc Driver
    "Menu_Category",        # Phụ thuộc Merchant
    "Option_Topping",       # Phụ thuộc Merchant
    "Food_Item",            # Phụ thuộc Category
    "Food_Topping_Mapping", # Phụ thuộc Food, Topping
    "Voucher",              # Độc lập (nhưng thường insert sau để tránh rối ID)
    "Cart",                 # Phụ thuộc User, Merchant
    "Cart_Item",            # Phụ thuộc Cart, Food
    "Cart_Item_Topping",    # Phụ thuộc Cart_Item, Topping
    "Order",                # Phụ thuộc User, Merchant, Driver, Voucher
    "Order_Detail",         # Phụ thuộc Order, Food
    "Order_Detail_Topping", # Phụ thuộc Order_Detail
    "Payment",              # Phụ thuộc Order
    "Review"                # Phụ thuộc Order
]

# --- 2. DANH SÁCH CÁC CỘT CẦN THÊM 'N' (NVARCHAR) ---
# Dựa trên Schema bạn cung cấp
UNICODE_COLS = {
    'Full_Name', 'Role_Name', 'Store_Name', 'Store_Address', 
    'Shop_Type', 'Vehicle_Type', 'Name_Category', 
    'Food_Name', 'Descriptions', 'Status_Food', 
    'Name_Option', 'Note', 'Voucher_Type', 
    'Delivery_Address', 'Topping_Name', 
    'Payment_Method', 'Status', 'Comment', 'Review_Type',
    'Address_Delivery'
}

def get_connection():
    conn_str = f"DRIVER={DB_CONFIG['driver']};SERVER={DB_CONFIG['server']};DATABASE={DB_CONFIG['database']};Trusted_Connection={DB_CONFIG['trusted_connection']}"
    return pyodbc.connect(conn_str)

def clean_value(val, col_name):
    """Xử lý giá trị để đưa vào câu lệnh SQL"""
    # 1. Xử lý NULL/None/NaN
    if val is None or pd.isna(val) or str(val).lower() == 'nan':
        return "NULL"
    
    # 2. Xử lý dữ liệu Text
    str_val = str(val).strip()
    
    # Escape dấu nháy đơn (') trong chuỗi -> ('')
    str_val = str_val.replace("'", "''")
    
    # Nếu là cột Unicode (Tiếng Việt) -> Thêm N phía trước
    if col_name in UNICODE_COLS:
        return f"N'{str_val}'"
    
    # Các cột Text thường (ID, Code, URL...) hoặc Ngày tháng dạng chuỗi
    # Kiểm tra nếu là số thì trả về số, ngược lại bao quanh bởi dấu nháy
    try:
        # Nếu convert được sang float mà không thay đổi giá trị (tránh trường hợp số điện thoại bị mất số 0)
        # Tuy nhiên ID và Phone là varchar nên vẫn cần dấu nháy
        # Cách an toàn nhất cho SQL Insert:
        # - Số (int/float) trong Excel -> Text trong SQL query thì không sao (SQL tự ép kiểu nếu cột là int)
        # - Nhưng Date/Varchar bắt buộc phải có nháy.
        
        # Logic đơn giản: Nếu cột nằm trong danh sách cần N' thì đã xử lý ở trên.
        # Còn lại cứ đóng dấu nháy đơn '...' trừ khi nó là số thực sự trong ngữ cảnh string
        return f"'{str_val}'"
    except:
        return f"'{str_val}'"

def import_excel_to_sql():
    print(f"🔄 Đang đọc file Excel: {EXCEL_FILE}...")
    try:
        # Đọc toàn bộ các sheet
        xls = pd.read_excel(EXCEL_FILE, sheet_name=None)
    except FileNotFoundError:
        print(f"❌ Lỗi: Không tìm thấy file {EXCEL_FILE}")
        return

    conn = get_connection()
    cursor = conn.cursor()

    print("🚀 Bắt đầu quá trình Import vào Database...")

    # Duyệt qua từng bảng theo đúng thứ tự (Table Order)
    for table_name in TABLE_ORDER:
        if table_name not in xls:
            print(f"⚠️ Cảnh báo: Không tìm thấy sheet '{table_name}' trong file Excel. Bỏ qua.")
            continue
            
        df = xls[table_name]
        
        if df.empty:
            print(f"⚠️ Bảng {table_name} không có dữ liệu.")
            continue

        print(f"   -> Đang Insert bảng: {table_name} ({len(df)} dòng)...")
        
        # Lấy danh sách cột
        columns = list(df.columns)
        col_str = ", ".join([f"[{c}]" for c in columns]) # Thêm [] để tránh lỗi từ khóa SQL
        
        # Xử lý Identity Insert cho bảng Voucher (nếu có cột Identity)
        identity_insert_on = False
        if table_name == "Voucher":
            try:
                cursor.execute(f"SET IDENTITY_INSERT {table_name} ON")
                identity_insert_on = True
            except:
                pass # Có thể bảng chưa tạo Identity hoặc lỗi khác, bỏ qua

        for index, row in df.iterrows():
            # Tạo list các giá trị đã được format (N'text', NULL, 'date'...)
            values = []
            for col in columns:
                raw_val = row[col]
                
                # Xử lý đặc biệt cho kiểu DateTime trong pandas
                if isinstance(raw_val, (pd.Timestamp, pd.DatetimeIndex)):
                    raw_val = raw_val.strftime('%Y-%m-%d %H:%M:%S')
                
                # Xử lý format SQL
                sql_val = clean_value(raw_val, col)
                
                # Nếu cột không phải unicode và giá trị là số (VD: Price, Rating), bỏ dấu nháy để đúng chuẩn (tùy chọn, SQL server khá thông minh nên '100' vào cột INT vẫn được)
                # Nhưng để an toàn với clean_value ở trên ta cứ để string format insert
                
                values.append(sql_val)
            
            val_str = ", ".join(values)
            query = f"INSERT INTO [{table_name}] ({col_str}) VALUES ({val_str})"
            
            try:
                cursor.execute(query)
            except pyodbc.Error as e:
                print(f"❌ Lỗi tại dòng {index+2} bảng {table_name}: {e}")
                print(f"   Query: {query}")
                # conn.rollback() # Có thể rollback nếu muốn dừng ngay
        
        # Tắt Identity Insert nếu đã bật
        if identity_insert_on:
            cursor.execute(f"SET IDENTITY_INSERT {table_name} OFF")

        conn.commit() # Commit sau khi xong mỗi bảng
        print(f"   ✅ Hoàn tất bảng {table_name}")

    conn.close()
    print("\n🎉 THÀNH CÔNG! Đã import toàn bộ dữ liệu.")

if __name__ == "__main__":
    import_excel_to_sql()
Giải thích các điểm quan trọng trong code:
TABLE_ORDER:

Tôi đã sắp xếp bằng tay dựa trên Schema SQL bạn đưa.

Ví dụ: Bảng Merchant có khóa ngoại User_ID trỏ tới bảng User. Do đó, bảng User phải được insert trước, sau đó mới tới Merchant. Tương tự với Order và Order_Detail.

UNICODE_COLS:

Đây là danh sách các cột trong Schema có kiểu nvarchar.

Hàm clean_value sẽ kiểm tra: Nếu tên cột nằm trong danh sách này -> thêm chữ N phía trước giá trị (Ví dụ: N'Bún bò'). Nếu không -> chỉ để 'Bún bò' (sẽ bị lỗi font trong SQL) hoặc 'US001'.

Xử lý dữ liệu (Hàm clean_value):

NaN/None: Chuyển thành NULL (không có dấu nháy).

Dấu nháy đơn ('): Tên người nước ngoài hoặc quán ăn có dấu ' (ví dụ: O'Neil) sẽ làm hỏng câu lệnh SQL. Code đã xử lý bằng cách nhân đôi dấu nháy (replace("'", "''")).

Date/Time: Chuyển đổi đối tượng Timestamp của Pandas sang chuỗi chuẩn SQL YYYY-MM-DD HH:MM:SS.

SET IDENTITY_INSERT:

Bảng Voucher trong Schema của bạn có Voucher_ID INT IDENTITY(1,1).

Nếu trong Excel bạn đã có sẵn cột ID (ví dụ: 1, 2, 3...), SQL Server mặc định sẽ chặn không cho insert vào cột Identity.

Script đã tự động bật SET IDENTITY_INSERT Voucher ON trước khi insert và tắt đi sau khi xong.

Cách sử dụng:
Đảm bảo file Excel ShopeeFood_Full_Data.xlsx nằm cùng thư mục với file .py.

Sửa dòng server trong DB_CONFIG thành tên Server SQL của bạn (ví dụ: LOCALHOST, ADMIN-PC\SQLEXPRESS).

Chạy lệnh: python import_data.py.

(.venv) PS D:\Tailieuhoctap\Frontend\hoccodeweb> python -u "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py"

🔄 Đang đọc file Excel: ShopeeFood_Full_Data.xlsx...

Traceback (most recent call last):

  File "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py", line 167, in <module>

    import_excel_to_sql()

  File "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py", line 96, in import_excel_to_sql

    conn = get_connection()

           ^^^^^^^^^^^^^^^^

  File "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py", line 54, in get_connection

    return pyodbc.connect(conn_str)

           ^^^^^^^^^^^^^^^^^^^^^^^^

pyodbc.OperationalError: ('08001', '[08001] [Microsoft][ODBC Driver 17 for SQL Server]SQL Server Network Interfaces: Error Locating Server/Instance Specified [xFFFFFFFF].  (-1) (SQLDriverConnect); [08001] [Microsoft][ODBC Driver 17 for SQL Server]Login timeout expired (0); [08001] [Microsoft][ODBC Driver 17 for SQL Server]A network-related or instance-specific error has occurred while establishing a connection to SQL Server. Server is not found or not accessible. Check if instance name is correct and if SQL Server is configured to allow remote connections. For more information see SQL Server Books Online. (-1)')

Lỗi 08001 - Error Locating Server/Instance Specified nghĩa là Python không tìm thấy SQL Server của bạn.

Nguyên nhân chính là trong đoạn code tôi gửi, dòng cấu hình server vẫn đang để giá trị mẫu là 'DESKTOP-NAME\\SQLEXPRESS'. Bạn cần thay nó bằng tên Server thật trên máy tính của bạn.

Hãy làm theo các bước sau để sửa:

Bước 1: Lấy tên Server chuẩn của bạn
Mở SQL Server Management Studio (SSMS) và kết nối vào database ShopeeFood như bình thường.

Mở một cửa sổ Query mới (New Query) và chạy câu lệnh sau:

SQL
SELECT @@SERVERNAME
Copy kết quả hiển thị ở dưới (Ví dụ: ADMIN-PC hoặc LAPTOP-ABC\SQLEXPRESS).

Bước 2: Sửa lại code Python
Mở file dstaixe.py, tìm đến phần DB_CONFIG (khoảng dòng 6-10) và sửa lại dòng 'server'.

Lưu ý cực kỳ quan trọng: Trong Python, dấu gạch chéo ngược \ là ký tự đặc biệt. Nếu tên server của bạn có chứa dấu \ (ví dụ MAY-CUA-TOI\SQLEXPRESS), bạn phải gấp đôi dấu gạch chéo đó thành \\.

Ví dụ:

Tên server thật: ACER-NITRO\SQLEXPRESS

Code phải viết là: 'server': 'ACER-NITRO\\SQLEXPRESS'

Sửa lại đoạn code như sau:

Python
# --- CẤU HÌNH KẾT NỐI ---
DB_CONFIG = {
    # Thay dòng dưới đây bằng tên bạn vừa copy ở Bước 1
    # Nhớ thêm dấu \ nếu server có dạng TÊN_MÁY\SQLEXPRESS
    'server': 'TÊN_SERVER_CỦA_BẠN',  
    
    'database': 'ShopeeFood',
    'driver': '{ODBC Driver 17 for SQL Server}', 
    'trusted_connection': 'yes'
}
Bước 3: Kiểm tra Driver (Nếu sửa tên rồi vẫn lỗi)
Lỗi cũng có thể do máy bạn chưa cài ODBC Driver 17. Bạn hãy thử đổi dòng driver sang các phiên bản khác xem máy bạn đang có cái nào:

Thử 1: 'driver': '{SQL Server}' (Đây là driver mặc định có sẵn trên mọi Windows, khả năng chạy được cao nhất).

Thử 2: 'driver': '{ODBC Driver 18 for SQL Server}'

Khuyên dùng: Bạn hãy thử sửa driver thành '{SQL Server}' trước vì nó dễ nhận nhất.

Code sửa nhanh (Copy đè vào đoạn đầu file của bạn):

Python
DB_CONFIG = {
    # Thay TÊN_MÁY_CỦA_BẠN ở đây (Ví dụ: DESKTOP-HKL32\SQLEXPRESS)
    'server': 'TÊN_MÁY_CỦA_BẠN',  
    'database': 'ShopeeFood',
    # Đổi sang driver mặc định của Windows cho dễ nhận
    'driver': '{SQL Server}', 
    'trusted_connection': 'yes'
}
Sau khi sửa và lưu file, hãy chạy lại lệnh python ... nhé!

LAPTOP-MAUAG945

Tuyệt vời! LAPTOP-MAUAG945 chính là tên Server (Server Name) của bạn.

Bây giờ bạn hãy quay lại file code Python (dstaixe.py), tìm đến đoạn DB_CONFIG ở đầu file và sửa lại chính xác như sau:

Python
# --- CẤU HÌNH KẾT NỐI ---
DB_CONFIG = {
    'server': 'LAPTOP-MAUAG945',   # <-- Đã điền tên máy của bạn
    'database': 'ShopeeFood',
    'driver': '{SQL Server}',      # <-- Đổi sang driver mặc định của Windows cho chắc chắn
    'trusted_connection': 'yes'
}
Lưu ý: Tôi đã đổi phần 'driver' thành '{SQL Server}' để đảm bảo máy tính nào cũng chạy được mà không cần cài thêm driver riêng lẻ.

Sau khi sửa xong, bạn hãy lưu file (Ctrl + S) và chạy lại lệnh này trong terminal:

PowerShell
python -u "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py"
Chúc bạn thành công! Nếu vẫn lỗi, hãy chụp lại màn hình lỗi gửi tôi nhé.

có 1 số bảng đã insert thành công nhưng sau đó nó liên tục chạy

Dựa vào hình ảnh lỗi bạn cung cấp (Lỗi The INSERT statement conflicted with the FOREIGN KEY constraint "FK_ODT_Detail"), nguyên nhân là do dữ liệu không đồng bộ giữa bảng cha và bảng con.

Cụ thể: Bảng Order_Detail_Topping đang cố gắng thêm một dòng dữ liệu tham chiếu đến Order_Detail_ID (ví dụ: DT15874), nhưng ID này lại KHÔNG TỒN TẠI trong bảng cha Order_Detail.

Điều này thường xảy ra do 2 lý do:

Lần chạy trước bị lỗi: Quá trình import bảng Order_Detail bị ngắt quãng hoặc lỗi ở dòng nào đó, khiến ID đó chưa được lưu vào database.

Chạy chồng dữ liệu: Bạn chạy script import nhiều lần. Các bảng cha (như User, Merchant) đã có dữ liệu nên lệnh Insert bị bỏ qua hoặc lỗi (do trùng Primary Key), nhưng script vẫn tiếp tục chạy đến bảng con và cố gắng insert dữ liệu mới vào, gây ra lệch pha.

GIẢI PHÁP TỐT NHẤT: LÀM SẠCH VÀ CHẠY LẠI
Để đảm bảo dữ liệu chuẩn xác nhất và không bị lỗi khóa ngoại lung tung, bạn cần xóa sạch dữ liệu cũ trong Database theo đúng thứ tự (xóa con trước, xóa cha sau) rồi chạy lại script Python import một lần duy nhất.

Bạn hãy làm theo 2 bước sau:

Bước 1: Xóa sạch dữ liệu cũ trong SQL Server
Mở SQL Server, New Query và chạy đoạn lệnh sau để xóa trắng dữ liệu (Code này dùng DELETE thay vì TRUNCATE để tránh lỗi khóa ngoại khi xóa):

SQL
USE ShopeeFood;
GO

-- 1. Xóa các bảng con cấp thấp nhất (Review, Payment, Topping chi tiết...)
DELETE FROM Review;
DELETE FROM Payment;
DELETE FROM Order_Detail_Topping;
DELETE FROM Cart_Item_Topping;
DELETE FROM Food_Topping_Mapping;

-- 2. Xóa các bảng cấp trung gian (Order Detail, Cart Item, Driver Location)
DELETE FROM Order_Detail;
DELETE FROM Cart_Item;
DELETE FROM Driver_Location;

-- 3. Xóa các bảng cấp cao hơn (Order, Cart, Food, Topping)
DELETE FROM [Order]; -- Order là từ khóa nên cần ngoặc []
DELETE FROM Cart;
DELETE FROM Food_Item;
DELETE FROM Option_Topping;

-- 4. Xóa các bảng danh mục và voucher
DELETE FROM Menu_Category;
DELETE FROM Voucher;

-- 5. Xóa các bảng User/Role và liên quan
DELETE FROM User_Role_Mapping;
DELETE FROM Merchant;
DELETE FROM Driver;
DELETE FROM [User];
DELETE FROM [Role];

-- 6. Reset lại Identity cho bảng Voucher (để ID chạy lại từ 1)
DBCC CHECKIDENT ('Voucher', RESEED, 0);

PRINT 'Deleting completed successfully!';
Bước 2: Chạy lại file Python Import
Sau khi Database đã trống trơn, bạn hãy chạy lại lệnh Python. Lúc này dữ liệu sẽ được nạp tuần tự từ đầu đến cuối mà không bị xung đột.

PowerShell
python -u "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py"
Mẹo nhỏ để script chạy nhanh hơn và an toàn hơn (Nâng cao)
Trong file dstaixe.py (code import) của bạn, đoạn clean_value và logic insert từng dòng (row-by-row) khá chậm với 10.000 dòng và dễ gây lỗi lẻ tẻ. Nếu sau khi làm cách trên mà vẫn muốn tối ưu, bạn có thể sửa đoạn vòng lặp insert trong hàm import_excel_to_sql thêm try...except để bỏ qua lỗi trùng lặp (nếu không muốn xóa DB), nhưng cách tốt nhất cho bài tập này vẫn là Xóa Hết -> Import Lại.

Nếu quá trình chạy vẫn bị dừng lại ở bảng Order_Detail, hãy chụp lại đúng cái lỗi đầu tiên xuất hiện ở bảng đó cho tôi, vì đó mới là nguyên nhân gốc rễ khiến bảng Order_Detail_Topping phía sau bị lỗi theo.

Bạn đã dừng câu trả lời này
vẫn liên tục chạy đoạn trên

Tôi đã kiểm tra lại 2 file quan trọng nhất là Order_Detail.csv và Order_Detail_Topping.csv từ dữ liệu bạn gửi. Kết quả khẳng định: Dữ liệu trong file Excel hoàn toàn chuẩn xác.

Tất cả các mã Order_Detail_ID xuất hiện trong bảng Topping đều đã có mặt trong bảng Order Detail.

Không có mã rác hay mã lỗi trong file Excel.

Nguyên nhân thực sự của lỗi "Liên tục chạy"
Vấn đề nằm ở Database SQL Server của bạn đang chứa dữ liệu rác (Dirty Data) do những lần chạy lỗi trước đó.

Lần chạy trước: Bảng Order_Detail mới chỉ nạp được một nửa (ví dụ đến dòng 5000) thì bị lỗi và dừng lại.

Lần chạy này:

Script cố gắng chèn lại từ dòng 1. Những dòng đã có (1-5000) sẽ báo lỗi "Trùng khóa chính" (Primary Key Violation) -> Bị bỏ qua.

Script tiếp tục chạy đến bảng con Order_Detail_Topping. Nó cố chèn topping cho dòng 5001.

LỖI XẢY RA: Database chưa có dòng 5001 của bảng cha (do bảng cha bị lỗi insert), nhưng bảng con lại đòi gắn topping vào đó. -> SQL chặn lại và báo lỗi FOREIGN KEY.

Vì bạn có hàng nghìn dòng topping, nên màn hình sẽ "liên tục chạy" hàng nghìn dòng lỗi tương tự nhau.

Giải pháp DUY NHẤT để sửa triệt để: "Làm sạch Database"
Bạn bắt buộc phải xóa sạch dữ liệu cũ trong SQL Server để nạp lại từ đầu. Đừng cố chạy đè, nó sẽ không bao giờ thành công.

Hãy làm theo đúng 2 bước sau:

Bước 1: Chạy lệnh SQL xóa sạch dữ liệu (Reset)
Mở SQL Server Management Studio (SSMS), New Query và chạy đoạn code này (tôi đã sắp xếp thứ tự xóa chuẩn để không bị lỗi):

SQL
USE ShopeeFood;
GO

-- Tắt kiểm tra khóa ngoại tạm thời để xóa nhanh
EXEC sp_msforeachtable "ALTER TABLE ? NOCHECK CONSTRAINT all"
GO

-- Xóa dữ liệu toàn bộ các bảng
DELETE FROM Review;
DELETE FROM Payment;
DELETE FROM Order_Detail_Topping;
DELETE FROM Cart_Item_Topping;
DELETE FROM Food_Topping_Mapping;
DELETE FROM Order_Detail;
DELETE FROM Cart_Item;
DELETE FROM Driver_Location;
DELETE FROM [Order];
DELETE FROM Cart;
DELETE FROM Food_Item;
DELETE FROM Option_Topping;
DELETE FROM Menu_Category;
DELETE FROM Voucher;
DELETE FROM User_Role_Mapping;
DELETE FROM Merchant;
DELETE FROM Driver;
DELETE FROM [User];
DELETE FROM [Role];

-- Reset lại bộ đếm ID tự động cho bảng Voucher
DBCC CHECKIDENT ('Voucher', RESEED, 0);
GO

-- Bật lại kiểm tra khóa ngoại
EXEC sp_msforeachtable "ALTER TABLE ? WITH CHECK CHECK CONSTRAINT all"
GO

PRINT '✅ Đã xóa sạch dữ liệu cũ thành công!';
Bước 2: Chạy lại script Python
Sau khi SQL báo "Đã xóa sạch dữ liệu cũ thành công", bạn quay lại terminal và chạy lệnh Python đúng 1 lần:

PowerShell
python -u "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py"
Lần này, script sẽ chạy mượt từ đầu đến cuối vì database đã trắng trơn, không còn xung đột ID cũ nữa.

Create database ShopeeFood



CREATE TABLE [User](

[User_ID] varchar(10) PRIMARY KEY,

Full_Name nvarchar(50) NOT NULL,

Birth_Date DATE NOT NULL,

Phone_Number varchar(10) UNIQUE NOT NULL,

Email varchar(50) UNIQUE NOT NULL,

Passwords varchar(30) NOT NULL,

Address_Delivery nvarchar(100) NOT NULL,

Shopee_Coins int DEFAULT 0 CONSTRAINT CK_coins_positive CHECK (Shopee_Coins >= 0)

);



CREATE TABLE [Role](

Role_ID varchar(10) PRIMARY KEY,

Role_Name nvarchar(50) NOT NULL

);



CREATE TABLE User_Role_Mapping(

[User_ID] varchar(10) NOT NULL,

[Role_ID] varchar(10) NOT NULL,

Assigned_Date DATETIME, 

PRIMARY KEY ([User_ID], [Role_ID]),

CONSTRAINT FK_URM_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID]),

CONSTRAINT FK_URM_Role FOREIGN KEY ([Role_ID]) REFERENCES [Role](Role_ID)

);



CREATE TABLE Merchant(

Merchant_ID varchar(10) PRIMARY KEY,

[User_ID] varchar(10) NOT NULL UNIQUE,

Store_Name nvarchar(100) NOT NULL,

Store_Address nvarchar(100) NOT NULL,

Open_Time time NOT NULL, 

Close_Time time NOT NULL, 

Active_Status tinyint NOT NULL,

Shop_Type nvarchar(50) NOT NULL,

Rating tinyint DEFAULT 5 CONSTRAINT CK_Merchant_Rating CHECK (Rating BETWEEN 1 AND 5),

CONSTRAINT FK_Merchant_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID])

);



CREATE TABLE Driver(

Driver_ID varchar(10) PRIMARY KEY,

[User_ID] varchar(10) NOT NULL UNIQUE,

Full_Name nvarchar(50) NOT NULL,

Birth_Date DATE NOT NULL,

Phone_Number varchar(10) UNIQUE NOT NULL,

LicensePlate varchar(15) NOT NULL,

Vehicle_Type nvarchar(50) NULL,

Is_Verified BIT DEFAULT 0,

CONSTRAINT FK_Driver_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID])

);



CREATE TABLE Driver_Location(

Driver_ID VARCHAR(10) PRIMARY KEY,

Latitude DECIMAL(9,6),

Longitude DECIMAL(9,6),

Updated_At DATETIME,

Is_Active BIT DEFAULT 0,

CONSTRAINT FK_Location_Driver FOREIGN KEY (Driver_ID) REFERENCES Driver(Driver_ID)

);



CREATE TABLE Menu_Category(

Category_ID varchar(10) PRIMARY KEY,

Merchant_ID varchar(10) NOT NULL,

Name_Category nvarchar(50) NOT NULL,

CONSTRAINT FK_Category_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID)

);



CREATE TABLE Food_Item(

Food_ID varchar(10) PRIMARY KEY,

Category_ID varchar(10) NOT NULL, 

Food_Name nvarchar(50) NOT NULL,

Original_Price DECIMAL(18, 0) CONSTRAINT CK_Original_Price CHECK (Original_Price >= 0),

Sale_Price DECIMAL(18, 0) CONSTRAINT CK_Sale_Price CHECK (Sale_Price >= 0),

Food_Image VARCHAR(255),

Descriptions nvarchar(255),

Status_Food nvarchar(20) NOT NULL,

CONSTRAINT FK_Food_Category FOREIGN KEY (Category_ID) REFERENCES Menu_Category(Category_ID)

);



CREATE TABLE Option_Topping(

Topping_ID varchar(10) PRIMARY KEY,

Merchant_ID varchar(10) NOT NULL,

Name_Option nvarchar(50),

Surcharge DECIMAL(18, 0) CONSTRAINT CK_Surcharge CHECK (Surcharge >= 0),

CONSTRAINT FK_Topping_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID)

);



CREATE TABLE Food_Topping_Mapping (

Mapping_ID varchar(10) PRIMARY KEY,

Food_ID varchar(10) NOT NULL,

Topping_ID varchar(10) NOT NULL,

CONSTRAINT FK_Mapping_Food FOREIGN KEY (Food_ID) REFERENCES Food_Item(Food_ID),

CONSTRAINT FK_Mapping_Topping FOREIGN KEY (Topping_ID) REFERENCES Option_Topping(Topping_ID),

CONSTRAINT UC_Food_Topping UNIQUE (Food_ID, Topping_ID)

);



CREATE TABLE Cart (

Cart_ID VARCHAR(10) PRIMARY KEY,

[User_ID] VARCHAR(10) NOT NULL,

Merchant_ID VARCHAR(10) NOT NULL,

Create_At DATETIME,

Subtotal_Price DECIMAL(18, 0) CONSTRAINT CK_Subtotal_Min CHECK (Subtotal_Price >= 0),

CONSTRAINT FK_Cart_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID]),

CONSTRAINT FK_Cart_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID)

);



CREATE TABLE Cart_Item (

Cart_Item_ID VARCHAR(10) PRIMARY KEY,

Cart_ID VARCHAR(10) NOT NULL,

Food_ID VARCHAR(10) NOT NULL,

Quantity INT NOT NULL CONSTRAINT CK_Cart_Quantity_Min CHECK (Quantity > 0),

Note NVARCHAR(255) null,

CONSTRAINT FK_CartItem_Cart FOREIGN KEY (Cart_ID) REFERENCES Cart(Cart_ID),

CONSTRAINT FK_CartItem_Food FOREIGN KEY (Food_ID) REFERENCES Food_Item(Food_ID)

);



CREATE TABLE Cart_Item_Topping (

Cart_Topping_ID VARCHAR(10) PRIMARY KEY,

Cart_Item_ID VARCHAR(10) NOT NULL,

Topping_ID VARCHAR(10) NOT NULL,

CONSTRAINT FK_CartTopping_Item FOREIGN KEY (Cart_Item_ID) REFERENCES Cart_Item(Cart_Item_ID),

CONSTRAINT FK_CartTopping_Topping FOREIGN KEY (Topping_ID) REFERENCES Option_Topping(Topping_ID)

);



CREATE TABLE Voucher (

Voucher_ID INT IDENTITY(1,1) PRIMARY KEY,

Voucher_Code VARCHAR(20) NOT NULL UNIQUE, 

Voucher_Type NVARCHAR(50), 

Discount_Value DECIMAL(18,0) NOT NULL, 

Min_Order_Value DECIMAL(18,0) DEFAULT 0, 

Max_Usage INT DEFAULT 1, 

[Start_Date] DATETIME,

End_Date DATETIME,

CONSTRAINT CK_Voucher_Value CHECK (Discount_Value >= 0)

);



CREATE TABLE [Order] (

Order_ID varchar(10) PRIMARY KEY,

[User_ID] VARCHAR(10) NOT NULL,

Merchant_ID VARCHAR(10) NOT NULL,

Driver_ID VARCHAR(10) NULL,

Voucher_ID INT NULL, 

Order_Time DATETIME,

Pickup_Time DATETIME NULL,

Delivery_Time DATETIME NULL,

Food_Amount DECIMAL(18,0) NOT NULL,

Shipping_Fee DECIMAL(18,0) NOT NULL,

Discount_Amount DECIMAL(18,0) DEFAULT 0,

Final_Amount AS (Food_Amount + Shipping_Fee - Discount_Amount),

[Status] TINYINT DEFAULT 1,

Delivery_Address NVARCHAR(255) NOT NULL,

CONSTRAINT FK_Order_User FOREIGN KEY ([User_ID]) REFERENCES [User]([User_ID]),

CONSTRAINT FK_Order_Merchant FOREIGN KEY (Merchant_ID) REFERENCES Merchant(Merchant_ID),

CONSTRAINT FK_Order_Voucher FOREIGN KEY (Voucher_ID) REFERENCES Voucher(Voucher_ID),

CONSTRAINT FK_Order_Driver FOREIGN KEY (Driver_ID) REFERENCES Driver(Driver_ID)

);



CREATE TABLE Order_Detail (

Order_Detail_ID varchar(10) PRIMARY KEY,

Order_ID varchar(10) NOT NULL,

Food_ID varchar(10) NOT NULL, 

Food_Name NVARCHAR(100) NOT NULL,

Quantity INT NOT NULL CHECK (Quantity > 0),

Unit_Price DECIMAL(18,0) NOT NULL,

CONSTRAINT FK_Detail_Order FOREIGN KEY (Order_ID) REFERENCES [Order](Order_ID),

CONSTRAINT FK_Detail_Food FOREIGN KEY (Food_ID) REFERENCES Food_Item(Food_ID)

);



CREATE TABLE Order_Detail_Topping (

OD_Topping_ID varchar(10) PRIMARY KEY,

Order_Detail_ID varchar(10) NOT NULL,

Topping_Name NVARCHAR(100) NOT NULL,

Topping_Price DECIMAL(18,0) NOT NULL,

CONSTRAINT FK_ODT_Detail FOREIGN KEY (Order_Detail_ID) REFERENCES Order_Detail(Order_Detail_ID)

);



CREATE TABLE Payment (

Payment_ID varchar(10) PRIMARY KEY,

Order_ID varchar(10) NOT NULL UNIQUE, 

Amount DECIMAL(18,0) NOT NULL,

Payment_Method NVARCHAR(50), 

Payment_Date DATETIME,

[Status] NVARCHAR(20),

CONSTRAINT FK_Payment_Order FOREIGN KEY (Order_ID) REFERENCES [Order](Order_ID)

);



CREATE TABLE Review (

Review_ID varchar(10) PRIMARY KEY,

Order_ID varchar(10) NOT NULL,

Rating TINYINT CHECK (Rating BETWEEN 1 AND 5),

Comment NVARCHAR(MAX),

Review_Type NVARCHAR(50),

Media_URL VARCHAR(255) null, 

CreatedAt DATETIME,

CONSTRAINT FK_Review_Order FOREIGN KEY (Order_ID) REFERENCES [Order](Order_ID)

);

Tôi đã kiểm tra kỹ lưỡng dữ liệu trong các file CSV bạn gửi, đặc biệt là mối quan hệ giữa bảng Order_Detail và Order_Detail_Topping.

Kết quả phân tích cho thấy: Dữ liệu trong file Excel của bạn hoàn toàn hợp lệ và chuẩn xác.

Mọi Order_Detail_ID trong bảng Topping đều tồn tại trong bảng Order Detail.

Không có mã rác hay dữ liệu sai lệch trong file nguồn.

Tại sao chương trình vẫn "liên tục chạy" và báo lỗi?
Vấn đề không nằm ở file Excel, mà nằm ở trạng thái hiện tại của Database SQL Server.

Đây là kịch bản đang xảy ra gây lỗi:

Lần chạy trước bị ngắt quãng: Bạn đã chạy script import, nhưng nó bị dừng đột ngột hoặc lỗi ở giữa chừng bảng Order_Detail. Ví dụ: Đã nạp được ID từ 1 đến 5000, nhưng ID từ 5001 đến 10000 chưa kịp vào Database.

Lần chạy hiện tại:

Script chạy lại từ đầu. Các dòng 1-5000 bị trùng khóa chính (Primary Key) -> Bị bỏ qua.

Script chạy tiếp đến bảng con Order_Detail_Topping. Nó cố gắng Insert topping cho đơn hàng có ID là 5001.

XUNG ĐỘT: Database trả về lỗi vì cha (Order Detail 5001) không tồn tại trong database (do lần trước chưa nạp xong), nhưng con (Topping) lại đòi tham chiếu tới nó.

Script tiếp tục lặp lại lỗi này cho hàng nghìn dòng tiếp theo, tạo ra hiện tượng "chạy liên tục" nhưng toàn báo lỗi đỏ.

Giải pháp duy nhất: "Làm sạch" Database (Clean & Reset)
Bạn không thể chạy đè lên dữ liệu cũ đang bị lỗi. Bạn cần xóa sạch dữ liệu trong các bảng theo đúng thứ tự và nạp lại từ đầu.

Hãy thực hiện đúng 2 bước sau:

Bước 1: Chạy lệnh SQL để xóa sạch dữ liệu cũ
Mở SQL Server Management Studio (SSMS), mở New Query và chạy đoạn lệnh sau. Đoạn lệnh này đã được sắp xếp thứ tự xóa từ "Con" đến "Cha" để không bị lỗi khóa ngoại.

SQL
USE ShopeeFood;
GO

-- Tắt kiểm tra khóa ngoại tạm thời để xóa nhanh hơn
EXEC sp_msforeachtable "ALTER TABLE ? NOCHECK CONSTRAINT all"
GO

-- 1. Xóa các bảng cấp thấp nhất (Con)
DELETE FROM Review;
DELETE FROM Payment;
DELETE FROM Order_Detail_Topping;
DELETE FROM Cart_Item_Topping;
DELETE FROM Food_Topping_Mapping;

-- 2. Xóa các bảng cấp trung gian
DELETE FROM Order_Detail;
DELETE FROM Cart_Item;
DELETE FROM Driver_Location;

-- 3. Xóa các bảng cấp cao (Cha)
DELETE FROM [Order];
DELETE FROM Cart;
DELETE FROM Food_Item;
DELETE FROM Option_Topping;

-- 4. Xóa các bảng danh mục và voucher
DELETE FROM Menu_Category;
DELETE FROM Voucher;

-- 5. Xóa các bảng User/Role và liên quan
DELETE FROM User_Role_Mapping;
DELETE FROM Merchant;
DELETE FROM Driver;
DELETE FROM [User];
DELETE FROM [Role];

-- Reset lại bộ đếm ID tự động cho bảng Voucher (để ID chạy lại từ 1)
DBCC CHECKIDENT ('Voucher', RESEED, 0);
GO

-- Bật lại kiểm tra khóa ngoại để đảm bảo an toàn dữ liệu sau này
EXEC sp_msforeachtable "ALTER TABLE ? WITH CHECK CHECK CONSTRAINT all"
GO

PRINT '✅ Đã xóa sạch dữ liệu cũ thành công! Database đã sẵn sàng để Import.';
Bước 2: Chạy lại file Python Import
Sau khi SQL Server báo "Đã xóa sạch dữ liệu cũ thành công", bạn hãy quay lại terminal và chạy lệnh Python import đúng một lần duy nhất.

PowerShell
python -u "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py"
Lần này, vì Database hoàn toàn trống, dữ liệu sẽ được nạp tuần tự từ User -> Merchant -> Order -> Order Detail -> Topping mà không gặp bất kỳ trở ngại nào.

   import_excel_to_sql()

  File "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py", line 97, in import_excel_to_sql

    conn = get_connection()

           ^^^^^^^^^^^^^^^^

  File "d:\Tailieuhoctap\Frontend\hoccodeweb\dstaixe.py", line 55, in get_connection

