Python
import pandas as pd
import pyodbc
import io
import datetime

# ================= 1. CẤU HÌNH KẾT NỐI (Đã điền sẵn thông tin của bạn) =================
DB_CONFIG = {
    'server': 'LAPTOP-MAUAG945',      
    'database': 'ShopeeFood',         
    'username': 'sa',                 
    'password': 'NguyenHai0151',      
}

CSV_FILE_PATH = 'ShopeeFood_Data.csv'

# ================= 2. THIẾT LẬP XỬ LÝ DỮ LIỆU =================

# Thứ tự import bắt buộc (Cha trước -> Con sau)
TABLE_ORDER = [
    'Users', 'Roles', 'Vouchers', 'UserRoles', 'Merchants', 'Drivers', 
    'DriverLocations', 'MenuCategories', 'ToppingOptions', 'FoodItems', 
    'FoodToppings', 'Carts', 'CartItems', 'CartItemToppings', 'Orders', 
    'OrderItems', 'OrderItemToppings', 'Payments', 'Reviews'
]

# Các cột ngày tháng (cần chuyển dd/mm/yyyy -> yyyy-mm-dd)
DATE_COLUMNS = [
    'BirthDate', 'AssignedDate', 'OpenTime', 'CloseTime', 'UpdatedAt', 
    'CreatedAt', 'StartDate', 'EndDate', 'OrderTime', 'PickupTime', 
    'DeliveryTime', 'PaymentDate'
]

# Các cột Số thực/Tiền tệ (Cần thay dấu phẩy ',' thành dấu chấm '.')
DECIMAL_COLUMNS = [
    'Latitude', 'Longitude',            
    'OriginalPrice', 'SalePrice',       
    'Surcharge',                        
    'SubtotalPrice',                    
    'DiscountValue', 'MinOrderValue',   
    'FoodAmount', 'ShippingFee', 'DiscountAmount', 
    'UnitPrice',                        
    'ToppingPrice',                     
    'Amount'                            
]

# Các cột Logic (BIT) - Cần xử lý kỹ để tránh lỗi "Parameter 5"
BIT_COLUMNS = ['IsActive', 'IsVerified', 'ActiveStatus']

# Các cột tự tính toán (Computed Columns) -> Phải loại bỏ khi Insert
COMPUTED_COLUMNS = ['FinalAmount']

# Mapping sửa tên cột sai (CSV -> SQL)
COLUMN_MAPPING = {
    'UserID': 'UserId',
    'Description': 'Descriptions',
    'MatKhau': 'Passwords',
    'Password': 'Passwords'
}

# ================= 3. CÁC HÀM XỬ LÝ CHÍNH =================

def get_connection():
    try:
        conn_str = (
            f"DRIVER={{ODBC Driver 17 for SQL Server}};"
            f"SERVER={DB_CONFIG['server']};"
            f"DATABASE={DB_CONFIG['database']};"
            f"UID={DB_CONFIG['username']};"
            f"PWD={DB_CONFIG['password']}"
        )
        return pyodbc.connect(conn_str)
    except Exception as e:
        print("LỖI KẾT NỐI: Vui lòng kiểm tra lại cấu hình SQL.")
        raise e

def parse_mixed_csv(file_path):
    """Đọc file CSV chứa nhiều bảng gộp chung"""
    tables = {}
    current_table = None
    buffer = []
    
    print(f"--> Đang đọc file {file_path}...")
    try:
        with open(file_path, 'r', encoding='utf-8-sig') as f:
            lines = f.readlines()

        for line in lines:
            line_content = line.strip()
            # Bỏ qua dòng trống
            if not line_content or line_content.replace(';', '') == '':
                continue
            
            # Kiểm tra xem dòng này có phải là tên bảng không
            parts = line_content.split(';')
            first_col = parts[0].strip()
            clean_name = first_col.replace("Bảng ", "").strip()
            
            if clean_name in TABLE_ORDER:
                # Lưu bảng cũ trước khi sang bảng mới
                if current_table and buffer:
                    csv_str = '\n'.join(buffer)
                    try:
                        # Đọc toàn bộ dưới dạng chuỗi (dtype=str) để dễ xử lý sau
                        df = pd.read_csv(io.StringIO(csv_str), sep=';', dtype=str)
                        tables[current_table] = df
                    except Exception as e:
                        print(f"    [Cảnh báo] Lỗi đọc bảng {current_table}: {e}")
                
                current_table = clean_name
                buffer = []
            else:
                if current_table:
                    buffer.append(line_content)

        # Lưu bảng cuối cùng
        if current_table and buffer:
            csv_str = '\n'.join(buffer)
            df = pd.read_csv(io.StringIO(csv_str), sep=';', dtype=str)
            tables[current_table] = df
            
        return tables
    except FileNotFoundError:
        print(f"[LỖI] Không tìm thấy file '{file_path}'.")
        return {}

def clean_and_import(table_name, df_input, cursor):
    # Tạo bản sao để tránh cảnh báo SettingWithCopyWarning
    df = df_input.copy()
    
    print(f"--> Đang xử lý bảng: {table_name} ({len(df)} dòng)...")
    
    if df.empty:
        return

    # 1. Chuẩn hóa tên cột & Mapping
    df.columns = [c.strip() for c in df.columns]
    df.rename(columns=COLUMN_MAPPING, inplace=True)
    
    # 2. Loại bỏ cột thừa (Unnamed) và cột Computed
    cols_to_drop = [c for c in df.columns if 'Unnamed' in c or c in COMPUTED_COLUMNS]
    if cols_to_drop:
        df.drop(columns=cols_to_drop, inplace=True)

    # 3. Xử lý Số điện thoại (Thêm số 0 nếu thiếu)
    if 'PhoneNumber' in df.columns:
        df['PhoneNumber'] = df['PhoneNumber'].apply(
            lambda x: '0' + str(x) if pd.notnull(x) and str(x).isdigit() and not str(x).startswith('0') else x
        )

    # 4. Xử lý Ngày tháng (dd/mm/yyyy -> yyyy-mm-dd)
    for col in DATE_COLUMNS:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], dayfirst=True, errors='coerce')
            # Định dạng lại thành chuỗi chuẩn SQL
            if col in ['OpenTime', 'CloseTime']:
                 df[col] = df[col].dt.strftime('%H:%M:%S')
            else:
                 df[col] = df[col].dt.strftime('%Y-%m-%d %H:%M:%S')

    # 5. Xử lý Cột Số (Decimal): Thay phẩy thành chấm
    for col in DECIMAL_COLUMNS:
        if col in df.columns:
            df[col] = df[col].astype(str).str.replace(',', '.', regex=False)
            df[col] = pd.to_numeric(df[col], errors='coerce')
            # Làm tròn tọa độ để tránh lỗi tràn số
            if col in ['Latitude', 'Longitude']:
                df[col] = df[col].round(6)

    # 6. [FIX QUAN TRỌNG] Xử lý cột BIT (IsActive)
    # Chuyển đổi mọi giá trị rỗng/lỗi thành 0, giá trị đúng thành 1
    for col in BIT_COLUMNS:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0).astype(int)

    # 7. Xử lý NULL (Thay 'nan', '' thành None)
    df = df.where(pd.notnull(df), None)
    df.replace(['nan', 'NULL', '', 'None'], None, inplace=True)

    # 8. Tạo câu lệnh SQL INSERT
    columns_sql = ",".join([f"[{c}]" for c in df.columns])
    placeholders = ",".join(["?"] * len(df.columns))
    sql = f"INSERT INTO {table_name} ({columns_sql}) VALUES ({placeholders})"
    
    # 9. Thực thi Insert
    data_to_insert = [tuple(x) for x in df.to_numpy()]
    
    try:
        # Bật IDENTITY_INSERT cho bảng Vouchers
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} ON")
            
        cursor.executemany(sql, data_to_insert)
        
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} OFF")
            
        print(f"    [OK] Đã import thành công {len(data_to_insert)} dòng vào {table_name}.")
        
    except Exception as e:
        print(f"    [LỖI] Tại bảng {table_name}: {e}")
        # In mẫu dữ liệu dòng đầu tiên để debug nếu lỗi
        if len(data_to_insert) > 0:
            print("    Mẫu dữ liệu dòng đầu (Debug):", data_to_insert[0])
        raise e

# ================= 4. CHƯƠNG TRÌNH CHÍNH =================
def main():
    conn = None
    try:
        conn = get_connection()
        cursor = conn.cursor()
        print("=== KẾT NỐI SQL SERVER THÀNH CÔNG ===")
        
        # 1. Đọc CSV
        tables_data = parse_mixed_csv(CSV_FILE_PATH)
        if not tables_data:
            return

        # 2. Chạy Import theo thứ tự
        for table_name in TABLE_ORDER:
            if table_name in tables_data:
                clean_and_import(table_name, tables_data[table_name], cursor)
            else:
                print(f"[Info] Không tìm thấy dữ liệu cho bảng {table_name}, bỏ qua.")
        
        # 3. Lưu thay đổi (Commit)
        conn.commit()
        print("\n=== TẤT CẢ ĐÃ HOÀN TẤT THÀNH CÔNG! ===")
        
    except Exception as e:
        if conn:
            conn.rollback()
        print(f"\n[FATAL ERROR] Đã Rollback toàn bộ. Lỗi: {e}")
    finally:
        if conn:
            conn.close()

if __name__ == "__main__":
    main()
Giải thích các điểm sửa chính:
Xử lý cột BIT (IsActive, IsVerified):

Mình thêm danh sách BIT_COLUMNS.

Trong hàm xử lý (Bước 6), code sẽ ép kiểu dữ liệu về số. Nếu gặp ô trống "" hoặc chữ tào lao, nó tự động chuyển thành số 0 (False). Điều này fix lỗi The supplied value is not a valid instance of data type float mà bạn gặp phải.

Làm tròn tọa độ:

Latitude và Longitude được làm tròn 6 chữ số thập phân (round(6)) để đảm bảo vừa vặn với kiểu DECIMAL(9,6) trong database.

Thay phẩy bằng chấm:

Đảm bảo tất cả các cột tiền tệ và số thực đều dùng dấu chấm thập phân (chuẩn SQL) thay vì dấu phẩy (chuẩn Excel Việt Nam).

