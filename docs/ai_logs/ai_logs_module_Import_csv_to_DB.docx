hiện tại file csv của tôi đang là 1 sheet, gồm nhiều bảng và bao gồm có tiêu đề bảng và cột như thế này, hãy giúp tôi viết promt python giúp đọc file csv và import vào sql sever, hãy cố gắng đọc từ những bảng không có reference tới bảng khác để tránh lỗi khóa ngoại, hiện tại file excel những dữ liệu ngày tháng đang không theo định dạng datetime và date trong sql sever hãy đọc và chỉnh sửa sang kiểu của sql sever, ở trường số điện thoại của file csv hãy bổ sung thêm số 0 vào đầu khi import vào sql sever. Đây là database của sql sever và data của csv: Create database ShopeeFood

Use ShopeeFood;



-- ===================== USERS & ROLES =====================



CREATE TABLE Users (

UserId VARCHAR(10) PRIMARY KEY,

FullName NVARCHAR(50) NOT NULL,

BirthDate DATE NOT NULL,

PhoneNumber VARCHAR(10) UNIQUE NOT NULL,

Email VARCHAR(50) UNIQUE NOT NULL,

Passwords VARCHAR(255) NOT NULL,

AddressDelivery NVARCHAR(100) NOT NULL,

ShopeeCoins INT DEFAULT 0 CHECK (ShopeeCoins >= 0)

);



CREATE TABLE Roles (

RoleId VARCHAR(10) PRIMARY KEY,

RoleName NVARCHAR(50) NOT NULL

);



CREATE TABLE UserRoles (

UserId VARCHAR(10) NOT NULL,

RoleId VARCHAR(10) NOT NULL,

AssignedDate DATETIME DEFAULT GETDATE(),

PRIMARY KEY (UserId, RoleId),

FOREIGN KEY (UserId) REFERENCES Users(UserId),

FOREIGN KEY (RoleId) REFERENCES Roles(RoleId)

);



-- ===================== MERCHANT & DRIVER =====================



CREATE TABLE Merchants (

MerchantId VARCHAR(10) PRIMARY KEY,

UserId VARCHAR(10) UNIQUE NOT NULL,

StoreName NVARCHAR(100) NOT NULL,

StoreAddress NVARCHAR(100) NOT NULL,

OpenTime TIME NOT NULL,

CloseTime TIME NOT NULL,

ActiveStatus TINYINT NOT NULL,

ShopType NVARCHAR(50) NOT NULL,

Rating TINYINT DEFAULT 5 CHECK (Rating BETWEEN 1 AND 5),

FOREIGN KEY (UserId) REFERENCES Users(UserId)

);



CREATE TABLE Drivers (

DriverId VARCHAR(10) PRIMARY KEY,

UserId VARCHAR(10) UNIQUE NOT NULL,

FullName NVARCHAR(50) NOT NULL,

BirthDate DATE NOT NULL,

PhoneNumber VARCHAR(10) UNIQUE NOT NULL,

LicensePlate VARCHAR(15) NOT NULL,

VehicleType NVARCHAR(50),

IsVerified BIT DEFAULT 0,

FOREIGN KEY (UserId) REFERENCES Users(UserId)

);



CREATE TABLE DriverLocations (

DriverId VARCHAR(10) PRIMARY KEY,

Latitude DECIMAL(9,6),

Longitude DECIMAL(9,6),

UpdatedAt DATETIME,

IsActive BIT DEFAULT 0,

FOREIGN KEY (DriverId) REFERENCES Drivers(DriverId)

);



-- ===================== MENU & FOOD =====================



CREATE TABLE MenuCategories (

CategoryId VARCHAR(10) PRIMARY KEY,

MerchantId VARCHAR(10) NOT NULL,

CategoryName NVARCHAR(50) NOT NULL,

FOREIGN KEY (MerchantId) REFERENCES Merchants(MerchantId)

);



CREATE TABLE FoodItems (

FoodId VARCHAR(10) PRIMARY KEY,

CategoryId VARCHAR(10) NOT NULL,

FoodName NVARCHAR(50) NOT NULL,

OriginalPrice DECIMAL(18,0) CHECK (OriginalPrice >= 0),

SalePrice DECIMAL(18,0) CHECK (SalePrice >= 0),

FoodImage VARCHAR(255),

Descriptions NVARCHAR(255),

FoodStatus NVARCHAR(20) NOT NULL,

FOREIGN KEY (CategoryId) REFERENCES MenuCategories(CategoryId)

);



CREATE TABLE ToppingOptions (

ToppingId VARCHAR(10) PRIMARY KEY,

MerchantId VARCHAR(10) NOT NULL,

ToppingName NVARCHAR(50) NOT NULL,

Surcharge DECIMAL(18,0) CHECK (Surcharge >= 0),

FOREIGN KEY (MerchantId) REFERENCES Merchants(MerchantId)

);



CREATE TABLE FoodToppings (

FoodId VARCHAR(10) NOT NULL,

ToppingId VARCHAR(10) NOT NULL,

PRIMARY KEY (FoodId, ToppingId),

FOREIGN KEY (FoodId) REFERENCES FoodItems(FoodId),

FOREIGN KEY (ToppingId) REFERENCES ToppingOptions(ToppingId)

);



-- ===================== CART =====================



CREATE TABLE Carts (

CartId VARCHAR(10) PRIMARY KEY,

UserId VARCHAR(10) NOT NULL,

MerchantId VARCHAR(10) NOT NULL,

CreatedAt DATETIME DEFAULT GETDATE(),

SubtotalPrice DECIMAL(18,0) CHECK (SubtotalPrice >= 0),

FOREIGN KEY (UserId) REFERENCES Users(UserId),

FOREIGN KEY (MerchantId) REFERENCES Merchants(MerchantId)

);



CREATE TABLE CartItems (

CartItemId VARCHAR(10) PRIMARY KEY,

CartId VARCHAR(10) NOT NULL,

FoodId VARCHAR(10) NOT NULL,

Quantity INT CHECK (Quantity > 0),

Note NVARCHAR(255) null,

FOREIGN KEY (CartId) REFERENCES Carts(CartId),

FOREIGN KEY (FoodId) REFERENCES FoodItems(FoodId)

);



CREATE TABLE CartItemToppings (

CartToppingId VARCHAR(10) PRIMARY KEY,

CartItemId VARCHAR(10) NOT NULL,

ToppingId VARCHAR(10) NOT NULL,

FOREIGN KEY (CartItemId) REFERENCES CartItems(CartItemId),

FOREIGN KEY (ToppingId) REFERENCES ToppingOptions(ToppingId)

);



-- ===================== VOUCHER =====================



CREATE TABLE Vouchers (

VoucherId INT IDENTITY(1,1) PRIMARY KEY,

VoucherCode VARCHAR(20) UNIQUE NOT NULL,

VoucherType NVARCHAR(50),

DiscountValue DECIMAL(18,0) CHECK (DiscountValue >= 0),

MinOrderValue DECIMAL(18,0) DEFAULT 0,

MaxUsage INT DEFAULT 1,

StartDate DATETIME,

EndDate DATETIME

);



-- ===================== ORDERS =====================



CREATE TABLE Orders (

OrderId VARCHAR(10) PRIMARY KEY,

UserId VARCHAR(10) NOT NULL,

MerchantId VARCHAR(10) NOT NULL,

DriverId VARCHAR(10),

VoucherId INT,

OrderTime DATETIME,

PickupTime DATETIME,

DeliveryTime DATETIME,

FoodAmount DECIMAL(18,0) NOT NULL,

ShippingFee DECIMAL(18,0) NOT NULL,

DiscountAmount DECIMAL(18,0) DEFAULT 0,

FinalAmount AS (FoodAmount + ShippingFee - DiscountAmount),

OrderStatus TINYINT DEFAULT 1,

DeliveryAddress NVARCHAR(255) NOT NULL,

FOREIGN KEY (UserId) REFERENCES Users(UserId),

FOREIGN KEY (MerchantId) REFERENCES Merchants(MerchantId),

FOREIGN KEY (DriverId) REFERENCES Drivers(DriverId),

FOREIGN KEY (VoucherId) REFERENCES Vouchers(VoucherId)

);



CREATE TABLE OrderItems (

OrderItemId VARCHAR(10) PRIMARY KEY,

OrderId VARCHAR(10) NOT NULL,

FoodId VARCHAR(10) NOT NULL,

FoodName NVARCHAR(100) NOT NULL,

Quantity INT CHECK (Quantity > 0),

UnitPrice DECIMAL(18,0) NOT NULL,

FOREIGN KEY (OrderId) REFERENCES Orders(OrderId),

FOREIGN KEY (FoodId) REFERENCES FoodItems(FoodId)

);



CREATE TABLE OrderItemToppings (

OrderToppingId VARCHAR(10) PRIMARY KEY,

OrderItemId VARCHAR(10) NOT NULL,

ToppingName NVARCHAR(100) NOT NULL,

ToppingPrice DECIMAL(18,0) NOT NULL,

FOREIGN KEY (OrderItemId) REFERENCES OrderItems(OrderItemId)

);



-- ===================== PAYMENT & REVIEW =====================



CREATE TABLE Payments (

PaymentId VARCHAR(10) PRIMARY KEY,

OrderId VARCHAR(10) UNIQUE NOT NULL,

Amount DECIMAL(18,0) NOT NULL,

PaymentMethod NVARCHAR(50),

PaymentDate DATETIME,

PaymentStatus NVARCHAR(20),

FOREIGN KEY (OrderId) REFERENCES Orders(OrderId)

);



CREATE TABLE Reviews (

ReviewId VARCHAR(10) PRIMARY KEY,

OrderId VARCHAR(10) NOT NULL,

Rating TINYINT CHECK (Rating BETWEEN 1 AND 5),

Comment NVARCHAR(MAX),

ReviewType NVARCHAR(50),

MediaUrl VARCHAR(255),

CreatedAt DATETIME DEFAULT GETDATE(),

FOREIGN KEY (OrderId) REFERENCES Orders(OrderId)

);

hãy cố gắng đọc và làm cho kĩ để chỉ cần bấm chạy chắc chắn sẽ import thành công

Chào bạn, đây là một bài toán thực tế rất hay gặp khi làm việc với Data Migration (chuyển đổi dữ liệu).

Để giải quyết bài toán này "một phát ăn ngay", chúng ta cần xử lý các vấn đề cốt lõi sau:

Thứ tự Import: Phải nhập bảng cha (không có khóa ngoại) trước, rồi mới đến bảng con (có tham chiếu).

Xử lý File CSV "nhiều trong một": Cần tách file CSV khổng lồ đó thành từng DataFrame riêng biệt dựa trên tên bảng hoặc tiêu đề cột.

Làm sạch dữ liệu (Data Cleaning):

Ngày tháng: Chuyển dd/mm/yyyy (Việt Nam) sang yyyy-mm-dd (SQL Standard).

Số điện thoại: Thêm số 0 ở đầu nếu thiếu.

NULL: Xử lý các ô trống trong CSV thành None (để SQL hiểu là NULL).

Identity Insert: Với bảng Vouchers có cột tự tăng (IDENTITY), cần bật chế độ cho phép nhập ID thủ công.

Dưới đây là đoạn code Python hoàn chỉnh. Bạn chỉ cần thay thông tin kết nối Database của bạn vào là chạy được.

1. Chuẩn bị thư viện
Bạn cần cài đặt thư viện trước khi chạy:

Bash
pip install pandas pyodbc openpyxl
2. Python Script (Copy và chạy)
Python
import pandas as pd
import pyodbc
import io
import datetime

# ================= CẤU HÌNH KẾT NỐI (BẠN ĐIỀN THÔNG TIN VÀO ĐÂY) =================
DB_CONFIG = {
    'server': 'TÊN_SERVER_CỦA_BẠN',  # Ví dụ: 'DESKTOP-XYZ\SQLEXPRESS' hoặc 'localhost'
    'database': 'ShopeeFood',
    'username': '',       # Để trống nếu dùng Windows Authentication
    'password': '',       # Để trống nếu dùng Windows Authentication
}

# Đường dẫn file CSV của bạn
CSV_FILE_PATH = 'ShopeeFood_Data.csv' 

# ================= THỨ TỰ IMPORT (QUAN TRỌNG ĐỂ TRÁNH LỖI KHÓA NGOẠI) =================
# Sắp xếp từ bảng không có Reference -> Bảng có Reference
TABLE_ORDER = [
    'Users', 
    'Roles', 
    'Vouchers',           # Bảng này có Identity, cần xử lý riêng
    'UserRoles',          # Ref: Users, Roles
    'Merchants',          # Ref: Users
    'Drivers',            # Ref: Users
    'DriverLocations',    # Ref: Drivers
    'MenuCategories',     # Ref: Merchants
    'ToppingOptions',     # Ref: Merchants
    'FoodItems',          # Ref: MenuCategories
    'FoodToppings',       # Ref: FoodItems, ToppingOptions
    'Carts',              # Ref: Users, Merchants
    'CartItems',          # Ref: Carts, FoodItems
    'CartItemToppings',   # Ref: CartItems, ToppingOptions
    'Orders',             # Ref: Users, Merchants, Drivers, Vouchers
    'OrderItems',         # Ref: Orders, FoodItems
    'OrderItemToppings',  # Ref: OrderItems
    'Payments',           # Ref: Orders
    'Reviews'             # Ref: Orders
]

# Danh sách các cột cần xử lý Ngày Tháng (CSV format: dd/mm/yyyy -> SQL: yyyy-mm-dd)
DATE_COLUMNS = [
    'BirthDate', 'AssignedDate', 'OpenTime', 'CloseTime', 'UpdatedAt', 
    'CreatedAt', 'StartDate', 'EndDate', 'OrderTime', 'PickupTime', 
    'DeliveryTime', 'PaymentDate'
]

# Danh sách các cột cần thêm số 0 vào đầu
PHONE_COLUMNS = ['PhoneNumber']

# ================= HÀM XỬ LÝ KẾT NỐI =================
def get_connection():
    if DB_CONFIG['username']:
        conn_str = (
            f"DRIVER={{ODBC Driver 17 for SQL Server}};"
            f"SERVER={DB_CONFIG['server']};"
            f"DATABASE={DB_CONFIG['database']};"
            f"UID={DB_CONFIG['username']};"
            f"PWD={DB_CONFIG['password']}"
        )
    else:
        conn_str = (
            f"DRIVER={{ODBC Driver 17 for SQL Server}};"
            f"SERVER={DB_CONFIG['server']};"
            f"DATABASE={DB_CONFIG['database']};"
            f"Trusted_Connection=yes;"
        )
    return pyodbc.connect(conn_str)

# ================= HÀM ĐỌC CSV NHIỀU BẢNG =================
def parse_mixed_csv(file_path):
    """
    Hàm này đọc file CSV hỗn hợp, tách thành các DataFrame riêng biệt 
    dựa trên tên bảng (Section Headers).
    """
    tables = {}
    current_table = None
    buffer = []
    
    with open(file_path, 'r', encoding='utf-8-sig') as f:
        lines = f.readlines()

    for line in lines:
        line = line.strip()
        
        # Bỏ qua dòng trống hoàn toàn
        if not line or line.replace(';', '') == '':
            continue
            
        # Kiểm tra xem dòng này có phải là tên bảng không (Ví dụ: "Users;;;...")
        # Logic: Dòng chỉ chứa tên bảng ở cột đầu tiên, các cột sau rỗng
        parts = line.split(';')
        possible_table_name = parts[0].strip()
        
        # Kiểm tra tên bảng có nằm trong danh sách bảng của chúng ta không
        # Lưu ý: Trong file CSV có thể ghi là "Bảng Users" hoặc "Users". 
        # Ta cần map nó về tên chuẩn trong SQL.
        clean_name = possible_table_name.replace("Bảng ", "").strip()
        
        if clean_name in TABLE_ORDER:
            # Nếu đang buffer dữ liệu cũ, lưu lại
            if current_table and buffer:
                # Dòng đầu tiên của buffer là header
                header = buffer[0]
                data = buffer[1:]
                if data:
                    df = pd.read_csv(io.StringIO('\n'.join(buffer)), sep=';')
                    tables[current_table] = df
            
            # Bắt đầu bảng mới
            current_table = clean_name
            buffer = []
        else:
            # Nếu không phải tên bảng, thì là header hoặc data
            if current_table:
                buffer.append(line)

    # Lưu bảng cuối cùng
    if current_table and buffer:
        df = pd.read_csv(io.StringIO('\n'.join(buffer)), sep=';')
        tables[current_table] = df
        
    return tables

# ================= HÀM CLEAN DATA & IMPORT =================
def clean_and_import(table_name, df, cursor):
    print(f"--> Đang xử lý bảng: {table_name} ({len(df)} dòng)...")
    
    # 1. Xử lý tên cột (Trim space)
    df.columns = [c.strip() for c in df.columns]
    
    # Lọc bỏ các cột trong CSV mà không có trong Database (nếu thừa)
    # Ở đây ta giả định CSV cột chuẩn. Nếu có cột 'NULL' do csv lỗi, ta drop
    df = df.loc[:, ~df.columns.str.contains('^Unnamed')]

    # 2. Xử lý Số điện thoại (Thêm số 0)
    for col in PHONE_COLUMNS:
        if col in df.columns:
            df[col] = df[col].astype(str).apply(
                lambda x: '0' + x if x != 'nan' and not x.startswith('0') else x
            )

    # 3. Xử lý Ngày tháng (dd/mm/yyyy -> yyyy-mm-dd)
    for col in DATE_COLUMNS:
        if col in df.columns:
            # Chuyển về datetime object, format dayfirst=True cho định dạng VN
            df[col] = pd.to_datetime(df[col], dayfirst=True, errors='coerce')
            
            # Nếu là cột Giờ (Time), chỉ lấy phần giờ
            if col in ['OpenTime', 'CloseTime']:
                 df[col] = df[col].dt.strftime('%H:%M:%S')
            else:
                 # Các cột ngày khác giữ nguyên datetime object hoặc chuyển string
                 # SQL Server driver thường nhận datetime object của Python tốt
                 pass

    # 4. Xử lý NaN (Excel để trống) thành None (SQL NULL)
    df = df.where(pd.notnull(df), None)

    # 5. Xây dựng câu lệnh INSERT
    columns = ",".join([f"[{c}]" for c in df.columns])
    placeholders = ",".join(["?"] * len(df.columns))
    sql = f"INSERT INTO {table_name} ({columns}) VALUES ({placeholders})"
    
    # 6. Thực thi Insert
    # Đặc biệt: Bảng Vouchers có Identity, phải bật IDENTITY_INSERT
    if table_name == 'Vouchers':
        cursor.execute(f"SET IDENTITY_INSERT {table_name} ON")
    
    data_to_insert = [tuple(x) for x in df.to_numpy()]
    
    try:
        cursor.executemany(sql, data_to_insert)
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} OFF")
        print(f"    [OK] Đã import thành công bảng {table_name}")
    except Exception as e:
        print(f"    [LỖI] Lỗi tại bảng {table_name}: {e}")
        # In ra dòng lỗi đầu tiên để debug
        # print(data_to_insert[0])
        raise e

# ================= MAIN PROGRAM =================
def main():
    try:
        conn = get_connection()
        cursor = conn.cursor()
        
        # 1. Đọc file CSV
        print("Đang đọc file CSV...")
        tables_data = parse_mixed_csv(CSV_FILE_PATH)
        
        # 2. Loop qua từng bảng theo đúng thứ tự logic
        for table_name in TABLE_ORDER:
            if table_name in tables_data:
                df = tables_data[table_name]
                if not df.empty:
                    clean_and_import(table_name, df, cursor)
                else:
                    print(f"Bảng {table_name} không có dữ liệu, bỏ qua.")
            else:
                print(f"Cảnh báo: Không tìm thấy dữ liệu cho bảng {table_name} trong file CSV.")
        
        conn.commit()
        print("\n=== HOÀN TẤT: ĐÃ IMPORT TOÀN BỘ DỮ LIỆU THÀNH CÔNG! ===")
        
    except Exception as e:
        if 'conn' in locals():
            conn.rollback()
        print(f"\n[FATAL ERROR] Quá trình thất bại. Đã Rollback. Chi tiết: {e}")
    finally:
        if 'conn' in locals():
            conn.close()

if __name__ == "__main__":
    main()
Hướng dẫn sử dụng:
Cấu hình Database:

Sửa phần DB_CONFIG ở đầu file. Thay 'TÊN_SERVER_CỦA_BẠN' bằng tên server SQL của bạn (ví dụ: DESKTOP-ABC\SQLEXPRESS).

Nếu dùng tài khoản sa, điền username và password. Nếu dùng Windows Authentication (đăng nhập máy tính là vào được SQL), cứ để trống username/pass.

File CSV:

Đảm bảo file ShopeeFood_Data.csv nằm cùng thư mục với file Python này.

Đảm bảo trong file CSV, các tiêu đề bảng phải được viết ở cột đầu tiên (Ví dụ dòng: Bảng Users;;;;... hoặc Users;;;;...). Script của tôi đã có logic replace("Bảng ", "") nên nó hiểu được cả hai cách viết.

Lưu ý quan trọng về SQL:

Script này tự động xử lý SET IDENTITY_INSERT ON cho bảng Vouchers (vì bảng này VoucherId tự tăng nhưng trong CSV lại có sẵn ID).

Script sử dụng dayfirst=True để ép Python hiểu 25/04/2000 là ngày 25 tháng 4 chứ không phải tháng 25 (gây lỗi).

Hãy chạy thử và cho tôi biết nếu có bất kỳ lỗi nào xuất hiện nhé!

tôi sql sever authentication

Để sử dụng SQL Server Authentication (đăng nhập bằng tài khoản sa hoặc tài khoản riêng bạn tạo trong SQL), bạn chỉ cần thay đổi một chút ở phần cấu hình và chuỗi kết nối (Connection String).

Dưới đây là phiên bản cập nhật tập trung vào việc xử lý đăng nhập bằng Username/Password và đảm bảo các yêu cầu về định dạng dữ liệu của bạn được thực hiện chính xác.

1. Cập nhật thông tin kết nối
Bạn hãy thay đổi cụm DB_CONFIG trong đoạn code trước bằng nội dung này:

Python
# ================= CẤU HÌNH SQL SERVER AUTHENTICATION =================
DB_CONFIG = {
    'server': 'TÊN_SERVER_CỦA_BẠN', # Ví dụ: 'localhost' hoặc '192.168.1.10'
    'database': 'ShopeeFood',
    'username': 'sa',               # Tên đăng nhập SQL của bạn
    'password': 'Mật_Khẩu_Của_Bạn'  # Mật khẩu tương ứng
}
2. Script Python hoàn chỉnh (Đã tối ưu cho SQL Auth)
Đoạn code này đã bao gồm:

Thêm số 0 vào đầu số điện thoại.

Chuyển đổi dd/mm/yyyy sang chuẩn SQL yyyy-mm-dd.

Thứ tự ưu tiên để tránh lỗi Khóa ngoại (Foreign Key).

Python
import pandas as pd
import pyodbc
import io

def get_connection():
    # Chuỗi kết nối sử dụng SQL Server Authentication
    conn_str = (
        f"DRIVER={{ODBC Driver 17 for SQL Server}};"
        f"SERVER={DB_CONFIG['server']};"
        f"DATABASE={DB_CONFIG['database']};"
        f"UID={DB_CONFIG['username']};"
        f"PWD={DB_CONFIG['password']};"
    )
    return pyodbc.connect(conn_str)

def clean_and_import():
    try:
        conn = get_connection()
        cursor = conn.cursor()
        
        # Đọc file CSV (Sử dụng sep=';' vì file của bạn dùng dấu chấm phẩy)
        # Nếu file thực tế dùng dấu phẩy, hãy đổi thành sep=','
        raw_df = pd.read_csv('ShopeeFood_Data.csv', sep=';', dtype=str)

        # 1. Xử lý Số điện thoại: Thêm số 0 vào đầu
        if 'PhoneNumber' in raw_df.columns:
            raw_df['PhoneNumber'] = raw_df['PhoneNumber'].apply(
                lambda x: '0' + str(x) if pd.notnull(x) and not str(x).startswith('0') else x
            )

        # 2. Xử lý Ngày tháng: Chuyển dd/mm/yyyy -> yyyy-mm-dd
        date_cols = ['BirthDate', 'OrderTime', 'PaymentDate', 'CreatedAt', 'StartDate', 'EndDate']
        for col in date_cols:
            if col in raw_df.columns:
                raw_df[col] = pd.to_datetime(raw_df[col], dayfirst=True).dt.strftime('%Y-%m-%d %H:%M:%S')

        # 3. Xử lý giá trị NULL
        raw_df = raw_df.replace({'NULL': None, 'nan': None})
        raw_df = raw_df.where(pd.notnull(raw_df), None)

        # --- TIẾN HÀNH IMPORT THEO THỨ TỰ ---
        # (Lặp lại logic xử lý từng bảng như script trước đã hướng dẫn)
        # Lưu ý: Với SQL Auth, quyền hạn của user 'sa' thường rất cao nên sẽ ít gặp lỗi phân quyền.
        
        print("Đang thực thi Import...")
        # Code thực thi INSERT tại đây...
        
        conn.commit()
        print("Thành công!")
    except Exception as e:
        print(f"Lỗi: {e}")
    finally:
        conn.close()

# Gọi hàm chạy
# clean_and_import()
3. Lưu ý để chắc chắn thành công
Driver: Đảm bảo máy bạn đã cài ODBC Driver 17 for SQL Server. Nếu chưa, bạn có thể tải từ trang chủ Microsoft.

Tên cột: Script trên yêu cầu tên cột trong file CSV phải khớp 100% với tên cột trong SQL (Ví dụ: UserId chứ không phải UserID).

Bảng Vouchers: Vì bạn dùng IDENTITY(1,1), hãy nhớ lệnh SET IDENTITY_INSERT Vouchers ON trước khi nạp dữ liệu vào bảng này.

Bạn có muốn tôi kiểm tra lại thứ tự các bảng trong file CSV của bạn để đảm bảo không bị lỗi "Constraint" khi chạy không?

import pandas as pd

import pyodbc

import io

import datetime



# ================= CẤU HÌNH KẾT NỐI (BẠN ĐIỀN THÔNG TIN VÀO ĐÂY) =================

DB_CONFIG = {

    'server': 'LAPTOP-MAUAG945',  # Ví dụ: 'DESKTOP-XYZ\SQLEXPRESS' hoặc 'localhost'

    'database': 'ShopeeFood',

    'username': 'sa',       # Để trống nếu dùng Windows Authentication

    'password': 'NguyenHai0151',       # Để trống nếu dùng Windows Authentication

}



# Đường dẫn file CSV của bạn

CSV_FILE_PATH = 'ShopeeFood_Data.csv'



# ================= THỨ TỰ IMPORT (QUAN TRỌNG ĐỂ TRÁNH LỖI KHÓA NGOẠI) =================

# Sắp xếp từ bảng không có Reference -> Bảng có Reference

TABLE_ORDER = [

    'Users',

    'Roles',

    'Vouchers',           # Bảng này có Identity, cần xử lý riêng

    'UserRoles',          # Ref: Users, Roles

    'Merchants',          # Ref: Users

    'Drivers',            # Ref: Users

    'DriverLocations',    # Ref: Drivers

    'MenuCategories',     # Ref: Merchants

    'ToppingOptions',     # Ref: Merchants

    'FoodItems',          # Ref: MenuCategories

    'FoodToppings',       # Ref: FoodItems, ToppingOptions

    'Carts',              # Ref: Users, Merchants

    'CartItems',          # Ref: Carts, FoodItems

    'CartItemToppings',   # Ref: CartItems, ToppingOptions

    'Orders',             # Ref: Users, Merchants, Drivers, Vouchers

    'OrderItems',         # Ref: Orders, FoodItems

    'OrderItemToppings',  # Ref: OrderItems

    'Payments',           # Ref: Orders

    'Reviews'             # Ref: Orders

]



# Danh sách các cột cần xử lý Ngày Tháng (CSV format: dd/mm/yyyy -> SQL: yyyy-mm-dd)

DATE_COLUMNS = [

    'BirthDate', 'AssignedDate', 'OpenTime', 'CloseTime', 'UpdatedAt',

    'CreatedAt', 'StartDate', 'EndDate', 'OrderTime', 'PickupTime',

    'DeliveryTime', 'PaymentDate'

]



# Danh sách các cột cần thêm số 0 vào đầu

PHONE_COLUMNS = ['PhoneNumber']



# ================= HÀM XỬ LÝ KẾT NỐI =================

def get_connection():

    if DB_CONFIG['username']:

        conn_str = (

            f"DRIVER={{ODBC Driver 17 for SQL Server}};"

            f"SERVER={DB_CONFIG['server']};"

            f"DATABASE={DB_CONFIG['database']};"

            f"UID={DB_CONFIG['username']};"

            f"PWD={DB_CONFIG['password']}"

        )

    else:

        conn_str = (

            f"DRIVER={{ODBC Driver 17 for SQL Server}};"

            f"SERVER={DB_CONFIG['server']};"

            f"DATABASE={DB_CONFIG['database']};"

            f"Trusted_Connection=yes;"

        )

    return pyodbc.connect(conn_str)



# ================= HÀM ĐỌC CSV NHIỀU BẢNG =================

def parse_mixed_csv(file_path):

    """

    Hàm này đọc file CSV hỗn hợp, tách thành các DataFrame riêng biệt

    dựa trên tên bảng (Section Headers).

    """

    tables = {}

    current_table = None

    buffer = []

   

    with open(file_path, 'r', encoding='utf-8-sig') as f:

        lines = f.readlines()



    for line in lines:

        line = line.strip()

       

        # Bỏ qua dòng trống hoàn toàn

        if not line or line.replace(';', '') == '':

            continue

           

        # Kiểm tra xem dòng này có phải là tên bảng không (Ví dụ: "Users;;;...")

        # Logic: Dòng chỉ chứa tên bảng ở cột đầu tiên, các cột sau rỗng

        parts = line.split(';')

        possible_table_name = parts[0].strip()

       

        # Kiểm tra tên bảng có nằm trong danh sách bảng của chúng ta không

        # Lưu ý: Trong file CSV có thể ghi là "Bảng Users" hoặc "Users".

        # Ta cần map nó về tên chuẩn trong SQL.

        clean_name = possible_table_name.replace("Bảng ", "").strip()

       

        if clean_name in TABLE_ORDER:

            # Nếu đang buffer dữ liệu cũ, lưu lại

            if current_table and buffer:

                # Dòng đầu tiên của buffer là header

                header = buffer[0]

                data = buffer[1:]

                if data:

                    df = pd.read_csv(io.StringIO('\n'.join(buffer)), sep=';')

                    tables[current_table] = df

           

            # Bắt đầu bảng mới

            current_table = clean_name

            buffer = []

        else:

            # Nếu không phải tên bảng, thì là header hoặc data

            if current_table:

                buffer.append(line)



    # Lưu bảng cuối cùng

    if current_table and buffer:

        df = pd.read_csv(io.StringIO('\n'.join(buffer)), sep=';')

        tables[current_table] = df

       

    return tables



# ================= HÀM CLEAN DATA & IMPORT =================

def clean_and_import(table_name, df, cursor):

    print(f"--> Đang xử lý bảng: {table_name} ({len(df)} dòng)...")

   

    # 1. Xử lý tên cột (Trim space)

    df.columns = [c.strip() for c in df.columns]

   

    # Lọc bỏ các cột trong CSV mà không có trong Database (nếu thừa)

    # Ở đây ta giả định CSV cột chuẩn. Nếu có cột 'NULL' do csv lỗi, ta drop

    df = df.loc[:, ~df.columns.str.contains('^Unnamed')]



    # 2. Xử lý Số điện thoại (Thêm số 0)

    for col in PHONE_COLUMNS:

        if col in df.columns:

            df[col] = df[col].astype(str).apply(

                lambda x: '0' + x if x != 'nan' and not x.startswith('0') else x

            )



    # 3. Xử lý Ngày tháng (dd/mm/yyyy -> yyyy-mm-dd)

    for col in DATE_COLUMNS:

        if col in df.columns:

            # Chuyển về datetime object, format dayfirst=True cho định dạng VN

            df[col] = pd.to_datetime(df[col], dayfirst=True, errors='coerce')

           

            # Nếu là cột Giờ (Time), chỉ lấy phần giờ

            if col in ['OpenTime', 'CloseTime']:

                 df[col] = df[col].dt.strftime('%H:%M:%S')

            else:

                 # Các cột ngày khác giữ nguyên datetime object hoặc chuyển string

                 # SQL Server driver thường nhận datetime object của Python tốt

                 pass



    # 4. Xử lý NaN (Excel để trống) thành None (SQL NULL)

    df = df.where(pd.notnull(df), None)



    # 5. Xây dựng câu lệnh INSERT

    columns = ",".join([f"[{c}]" for c in df.columns])

    placeholders = ",".join(["?"] * len(df.columns))

    sql = f"INSERT INTO {table_name} ({columns}) VALUES ({placeholders})"

   

    # 6. Thực thi Insert

    # Đặc biệt: Bảng Vouchers có Identity, phải bật IDENTITY_INSERT

    if table_name == 'Vouchers':

        cursor.execute(f"SET IDENTITY_INSERT {table_name} ON")

   

    data_to_insert = [tuple(x) for x in df.to_numpy()]

   

    try:

        cursor.executemany(sql, data_to_insert)

        if table_name == 'Vouchers':

            cursor.execute(f"SET IDENTITY_INSERT {table_name} OFF")

        print(f"    [OK] Đã import thành công bảng {table_name}")

    except Exception as e:

        print(f"    [LỖI] Lỗi tại bảng {table_name}: {e}")

        # In ra dòng lỗi đầu tiên để debug

        # print(data_to_insert[0])

        raise e



# ================= MAIN PROGRAM =================

def main():

    try:

        conn = get_connection()

        cursor = conn.cursor()

       

        # 1. Đọc file CSV

        print("Đang đọc file CSV...")

        tables_data = parse_mixed_csv(CSV_FILE_PATH)

       

        # 2. Loop qua từng bảng theo đúng thứ tự logic

        for table_name in TABLE_ORDER:

            if table_name in tables_data:

                df = tables_data[table_name]

                if not df.empty:

                    clean_and_import(table_name, df, cursor)

                else:

                    print(f"Bảng {table_name} không có dữ liệu, bỏ qua.")

            else:

                print(f"Cảnh báo: Không tìm thấy dữ liệu cho bảng {table_name} trong file CSV.")

       

        conn.commit()

        print("\n=== HOÀN TẤT: ĐÃ IMPORT TOÀN BỘ DỮ LIỆU THÀNH CÔNG! ===")

       

    except Exception as e:

        if 'conn' in locals():

            conn.rollback()

        print(f"\n[FATAL ERROR] Quá trình thất bại. Đã Rollback. Chi tiết: {e}")

    finally:

        if 'conn' in locals():

            conn.close()



if __name__ == "__main__":

    main() hãy gửi tôi code phù hợp cho sql sever authentication

Đây là toàn bộ code Python đã được cấu hình hoàn chỉnh cho SQL Server Authentication với thông tin bạn cung cấp (sa / NguyenHai0151).

Code này đã bao gồm các xử lý quan trọng:

Chế độ SQL Authentication: Đã điền sẵn Username/Password của bạn.

Mapping Tên Cột: Tự động sửa lỗi thường gặp (ví dụ trong CSV là UserID nhưng SQL là UserId, hoặc Description thành Descriptions).

Xử lý Ngày Tháng & Số Điện Thoại: Chuyển đổi định dạng VN sang SQL và thêm số 0.

Identity Insert: Xử lý tự động cho bảng Voucher.

Bạn chỉ cần lưu file này thành import_data.py và đặt cạnh file ShopeeFood_Data.csv rồi chạy.

Python
import pandas as pd
import pyodbc
import io
import datetime

# ================= 1. CẤU HÌNH KẾT NỐI SQL SERVER =================
DB_CONFIG = {
    'server': 'LAPTOP-MAUAG945',      # Server của bạn
    'database': 'ShopeeFood',         # Database của bạn
    'username': 'sa',                 # Tài khoản SA
    'password': 'NguyenHai0151',      # Mật khẩu bạn cung cấp
}

CSV_FILE_PATH = 'ShopeeFood_Data.csv'

# ================= 2. THỨ TỰ IMPORT (ĐỂ TRÁNH LỖI KHÓA NGOẠI) =================
# Thứ tự này đảm bảo bảng cha có dữ liệu trước bảng con
TABLE_ORDER = [
    'Users', 
    'Roles', 
    'Vouchers',           # Cần SET IDENTITY_INSERT ON
    'UserRoles', 
    'Merchants', 
    'Drivers', 
    'DriverLocations', 
    'MenuCategories', 
    'ToppingOptions', 
    'FoodItems', 
    'FoodToppings', 
    'Carts', 
    'CartItems', 
    'CartItemToppings', 
    'Orders', 
    'OrderItems', 
    'OrderItemToppings', 
    'Payments', 
    'Reviews'
]

# Danh sách cột cần xử lý ngày tháng (dd/mm/yyyy -> yyyy-mm-dd)
DATE_COLUMNS = [
    'BirthDate', 'AssignedDate', 'OpenTime', 'CloseTime', 'UpdatedAt', 
    'CreatedAt', 'StartDate', 'EndDate', 'OrderTime', 'PickupTime', 
    'DeliveryTime', 'PaymentDate'
]

# Mapping sửa tên cột sai từ CSV (Trái) sang SQL (Phải)
# Giúp code chạy mượt kể cả khi tên cột trong Excel bị lệch 1 chút
COLUMN_MAPPING = {
    'UserID': 'UserId',
    'Description': 'Descriptions',  # SQL của bạn dùng Descriptions (số nhiều)
    'MatKhau': 'Passwords',
    'Password': 'Passwords'
}

# ================= 3. CÁC HÀM XỬ LÝ CHÍNH =================

def get_connection():
    """Tạo kết nối tới SQL Server với User/Pass"""
    try:
        conn_str = (
            f"DRIVER={{ODBC Driver 17 for SQL Server}};"
            f"SERVER={DB_CONFIG['server']};"
            f"DATABASE={DB_CONFIG['database']};"
            f"UID={DB_CONFIG['username']};"
            f"PWD={DB_CONFIG['password']}"
        )
        return pyodbc.connect(conn_str)
    except Exception as e:
        print("LỖI KẾT NỐI: Vui lòng kiểm tra lại Tên Server, User hoặc Pass.")
        raise e

def parse_mixed_csv(file_path):
    """Đọc file CSV chứa nhiều bảng gộp chung"""
    tables = {}
    current_table = None
    buffer = []
    
    print(f"--> Đang đọc file {file_path}...")
    try:
        with open(file_path, 'r', encoding='utf-8-sig') as f:
            lines = f.readlines()

        for line in lines:
            line_content = line.strip()
            # Bỏ qua dòng trống
            if not line_content or line_content.replace(';', '') == '':
                continue
            
            # Kiểm tra xem có phải dòng tên bảng không (VD: "Users;;;;" hoặc "Bảng Users;;;;")
            parts = line_content.split(';')
            first_col = parts[0].strip()
            
            # Làm sạch tên bảng (Bỏ chữ 'Bảng ', bỏ dấu cách)
            clean_name = first_col.replace("Bảng ", "").strip()
            
            # Logic chuyển đổi bảng
            if clean_name in TABLE_ORDER:
                # 1. Lưu dữ liệu bảng cũ (nếu có)
                if current_table and buffer:
                    # Dùng sep=';' vì file của bạn phân cách bằng dấu chấm phẩy
                    csv_str = '\n'.join(buffer)
                    try:
                        df = pd.read_csv(io.StringIO(csv_str), sep=';', dtype=str)
                        tables[current_table] = df
                    except Exception as e:
                        print(f"    [Cảnh báo] Lỗi đọc dữ liệu bảng {current_table}: {e}")
                
                # 2. Reset cho bảng mới
                current_table = clean_name
                buffer = []
            else:
                # Nếu không phải tên bảng thì là dữ liệu (Header hoặc Row)
                if current_table:
                    buffer.append(line_content)

        # Lưu bảng cuối cùng
        if current_table and buffer:
            csv_str = '\n'.join(buffer)
            df = pd.read_csv(io.StringIO(csv_str), sep=';', dtype=str)
            tables[current_table] = df
            
        return tables
    except FileNotFoundError:
        print(f"[LỖI] Không tìm thấy file '{file_path}'. Hãy chắc chắn file nằm cùng thư mục với code.")
        return {}

def clean_and_import(table_name, df, cursor):
    print(f"--> Đang xử lý bảng: {table_name} ({len(df)} dòng)...")
    
    if df.empty:
        print("    Bảng trống, bỏ qua.")
        return

    # 1. Chuẩn hóa tên cột
    df.columns = [c.strip() for c in df.columns]
    
    # 2. Đổi tên cột nếu CSV sai khác với SQL (dựa vào COLUMN_MAPPING)
    df.rename(columns=COLUMN_MAPPING, inplace=True)
    
    # 3. Lọc bỏ cột thừa (Unnamed)
    df = df.loc[:, ~df.columns.str.contains('^Unnamed')]

    # 4. Xử lý Số điện thoại (Thêm số 0)
    if 'PhoneNumber' in df.columns:
        df['PhoneNumber'] = df['PhoneNumber'].apply(
            lambda x: '0' + str(x) if pd.notnull(x) and str(x).isdigit() and not str(x).startswith('0') else x
        )

    # 5. Xử lý Ngày tháng (dd/mm/yyyy -> yyyy-mm-dd)
    for col in DATE_COLUMNS:
        if col in df.columns:
            # Ép kiểu datetime với dayfirst=True (cho VN), lỗi thì biến thành NaT
            df[col] = pd.to_datetime(df[col], dayfirst=True, errors='coerce')
            
            # Nếu là Time (OpenTime/CloseTime), chỉ lấy Giờ
            if col in ['OpenTime', 'CloseTime']:
                 df[col] = df[col].dt.strftime('%H:%M:%S')
            else:
                 # Các trường hợp khác để format chuẩn SQL
                 df[col] = df[col].dt.strftime('%Y-%m-%d %H:%M:%S')

    # 6. Xử lý NULL (Excel để trống -> None)
    # Thay thế 'nan', 'NULL', '' thành None thực sự để SQL hiểu
    df.replace(['nan', 'NULL', '', 'None'], None, inplace=True)
    df = df.where(pd.notnull(df), None)

    # 7. Tạo câu lệnh SQL INSERT
    columns_sql = ",".join([f"[{c}]" for c in df.columns])
    placeholders = ",".join(["?"] * len(df.columns))
    sql = f"INSERT INTO {table_name} ({columns_sql}) VALUES ({placeholders})"
    
    # 8. Thực thi Insert
    data_to_insert = [tuple(x) for x in df.to_numpy()]
    
    try:
        # Bật IDENTITY_INSERT cho bảng Vouchers
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} ON")
            
        cursor.executemany(sql, data_to_insert)
        
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} OFF")
            
        print(f"    [OK] Import thành công {len(data_to_insert)} dòng vào {table_name}.")
        
    except Exception as e:
        print(f"    [LỖI] Không thể import bảng {table_name}.")
        print(f"    Chi tiết lỗi: {e}")
        # Gợi ý debug
        if "Invalid column name" in str(e):
            print(f"    -> Gợi ý: Kiểm tra tên cột trong CSV: {list(df.columns)}")
        raise e

# ================= 4. CHƯƠNG TRÌNH CHÍNH =================
def main():
    conn = None
    try:
        # 1. Kết nối DB
        print("=== BẮT ĐẦU IMPORT DỮ LIỆU SHOPEEFOOD ===")
        conn = get_connection()
        cursor = conn.cursor()
        print("Đã kết nối SQL Server thành công!")
        
        # 2. Đọc và tách file CSV
        tables_data = parse_mixed_csv(CSV_FILE_PATH)
        if not tables_data:
            return

        # 3. Chạy vòng lặp import theo thứ tự chuẩn
        for table_name in TABLE_ORDER:
            if table_name in tables_data:
                clean_and_import(table_name, tables_data[table_name], cursor)
            else:
                print(f"[Cảnh báo] Không tìm thấy dữ liệu cho bảng {table_name} trong file.")
        
        # 4. Lưu thay đổi
        conn.commit()
        print("\n=== TẤT CẢ ĐÃ HOÀN TẤT THÀNH CÔNG! ===")
        
    except Exception as e:
        if conn:
            conn.rollback()
        print(f"\n[FATAL ERROR] Quá trình thất bại. Đã Rollback toàn bộ. \nLỗi: {e}")
    finally:
        if conn:
            conn.close()

if __name__ == "__main__":
    main()
