Lỗi Error converting data type nvarchar to numeric xảy ra tại bảng DriverLocations là do hai cột Latitude và Longitude (Kinh độ/Vĩ độ) trong file CSV có thể đang chứa dấu phẩy , (ví dụ: 10,762622) hoặc ký tự lạ, trong khi SQL Server yêu cầu định dạng dấu chấm . (ví dụ: 10.762622) cho kiểu dữ liệu DECIMAL.

Ngoài ra, các cảnh báo SettingWithCopyWarning tuy không gây lỗi nhưng làm code chạy không mượt.

Dưới đây là đoạn code đã sửa lỗi hoàn chỉnh. Mình đã thêm phần xử lý chuyên biệt cho các cột số (Decimal/Float) để đảm bảo thay dấu phẩy thành dấu chấm và loại bỏ các cột tự tính toán (như FinalAmount trong bảng Orders) để tránh lỗi tiếp theo.

Bạn hãy copy và chạy lại file này nhé:

Python
import pandas as pd
import pyodbc
import io
import datetime

# ================= 1. CẤU HÌNH KẾT NỐI SQL SERVER =================
DB_CONFIG = {
    'server': 'LAPTOP-MAUAG945',      
    'database': 'ShopeeFood',         
    'username': 'sa',                 
    'password': 'NguyenHai0151',      
}

CSV_FILE_PATH = 'ShopeeFood_Data.csv'

# ================= 2. CẤU HÌNH XỬ LÝ DỮ LIỆU =================

# Thứ tự import chuẩn
TABLE_ORDER = [
    'Users', 'Roles', 'Vouchers', 'UserRoles', 'Merchants', 'Drivers', 
    'DriverLocations', 'MenuCategories', 'ToppingOptions', 'FoodItems', 
    'FoodToppings', 'Carts', 'CartItems', 'CartItemToppings', 'Orders', 
    'OrderItems', 'OrderItemToppings', 'Payments', 'Reviews'
]

# Cột ngày tháng cần chuyển format
DATE_COLUMNS = [
    'BirthDate', 'AssignedDate', 'OpenTime', 'CloseTime', 'UpdatedAt', 
    'CreatedAt', 'StartDate', 'EndDate', 'OrderTime', 'PickupTime', 
    'DeliveryTime', 'PaymentDate'
]

# Cột số thực (Decimal) cần xử lý dấu phẩy (,) thành dấu chấm (.)
DECIMAL_COLUMNS = [
    'Latitude', 'Longitude',            # DriverLocations
    'OriginalPrice', 'SalePrice',       # FoodItems
    'Surcharge',                        # ToppingOptions
    'SubtotalPrice',                    # Carts
    'DiscountValue', 'MinOrderValue',   # Vouchers
    'FoodAmount', 'ShippingFee', 'DiscountAmount', # Orders
    'UnitPrice',                        # OrderItems
    'ToppingPrice',                     # OrderItemToppings
    'Amount'                            # Payments
]

# Các cột Compute (Tự tính toán trong SQL) -> Cần loại bỏ khỏi file CSV khi Insert
# Ví dụ: FinalAmount trong bảng Orders là cột AS (...)
COMPUTED_COLUMNS = ['FinalAmount']

# Mapping sửa tên cột sai
COLUMN_MAPPING = {
    'UserID': 'UserId',
    'Description': 'Descriptions',
    'MatKhau': 'Passwords',
    'Password': 'Passwords'
}

# ================= 3. CÁC HÀM XỬ LÝ CHÍNH =================

def get_connection():
    try:
        conn_str = (
            f"DRIVER={{ODBC Driver 17 for SQL Server}};"
            f"SERVER={DB_CONFIG['server']};"
            f"DATABASE={DB_CONFIG['database']};"
            f"UID={DB_CONFIG['username']};"
            f"PWD={DB_CONFIG['password']}"
        )
        return pyodbc.connect(conn_str)
    except Exception as e:
        print("LỖI KẾT NỐI: Vui lòng kiểm tra lại cấu hình.")
        raise e

def parse_mixed_csv(file_path):
    tables = {}
    current_table = None
    buffer = []
    
    print(f"--> Đang đọc file {file_path}...")
    try:
        with open(file_path, 'r', encoding='utf-8-sig') as f:
            lines = f.readlines()

        for line in lines:
            line_content = line.strip()
            if not line_content or line_content.replace(';', '') == '':
                continue
            
            parts = line_content.split(';')
            first_col = parts[0].strip()
            clean_name = first_col.replace("Bảng ", "").strip()
            
            if clean_name in TABLE_ORDER:
                if current_table and buffer:
                    csv_str = '\n'.join(buffer)
                    try:
                        # Đọc tất cả là string để xử lý thủ công sau
                        df = pd.read_csv(io.StringIO(csv_str), sep=';', dtype=str)
                        tables[current_table] = df
                    except Exception as e:
                        print(f"    [Cảnh báo] Lỗi đọc bảng {current_table}: {e}")
                
                current_table = clean_name
                buffer = []
            else:
                if current_table:
                    buffer.append(line_content)

        if current_table and buffer:
            csv_str = '\n'.join(buffer)
            df = pd.read_csv(io.StringIO(csv_str), sep=';', dtype=str)
            tables[current_table] = df
            
        return tables
    except FileNotFoundError:
        print(f"[LỖI] Không tìm thấy file '{file_path}'.")
        return {}

def clean_and_import(table_name, df_input, cursor):
    # Tạo bản sao để tránh lỗi SettingWithCopyWarning
    df = df_input.copy()
    
    print(f"--> Đang xử lý bảng: {table_name} ({len(df)} dòng)...")
    
    if df.empty:
        return

    # 1. Chuẩn hóa tên cột
    df.columns = [c.strip() for c in df.columns]
    df.rename(columns=COLUMN_MAPPING, inplace=True)
    
    # 2. Loại bỏ cột Unnamed và cột Computed (tự tính)
    cols_to_drop = [c for c in df.columns if 'Unnamed' in c or c in COMPUTED_COLUMNS]
    if cols_to_drop:
        df.drop(columns=cols_to_drop, inplace=True)

    # 3. Xử lý Số điện thoại (Thêm số 0)
    if 'PhoneNumber' in df.columns:
        df['PhoneNumber'] = df['PhoneNumber'].apply(
            lambda x: '0' + str(x) if pd.notnull(x) and str(x).isdigit() and not str(x).startswith('0') else x
        )

    # 4. Xử lý Ngày tháng (dd/mm/yyyy -> yyyy-mm-dd)
    for col in DATE_COLUMNS:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], dayfirst=True, errors='coerce')
            if col in ['OpenTime', 'CloseTime']:
                 df[col] = df[col].dt.strftime('%H:%M:%S')
            else:
                 df[col] = df[col].dt.strftime('%Y-%m-%d %H:%M:%S')

    # 5. Xử lý Cột Số (Decimal/Money): Thay dấu phẩy bằng dấu chấm
    for col in DECIMAL_COLUMNS:
        if col in df.columns:
            # Thay thế dấu phẩy bằng dấu chấm, loại bỏ ký tự không phải số
            df[col] = df[col].astype(str).str.replace(',', '.', regex=False)
            # Ép kiểu về số (float), lỗi thành NaN
            df[col] = pd.to_numeric(df[col], errors='coerce')

    # 6. Xử lý NULL
    # Thay thế tất cả giá trị rỗng/lỗi thành None (SQL NULL)
    df = df.where(pd.notnull(df), None)
    df.replace(['nan', 'NULL', '', 'None'], None, inplace=True)

    # 7. Tạo SQL Insert
    columns_sql = ",".join([f"[{c}]" for c in df.columns])
    placeholders = ",".join(["?"] * len(df.columns))
    sql = f"INSERT INTO {table_name} ({columns_sql}) VALUES ({placeholders})"
    
    # 8. Thực thi
    data_to_insert = [tuple(x) for x in df.to_numpy()]
    
    try:
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} ON")
            
        cursor.executemany(sql, data_to_insert)
        
        if table_name == 'Vouchers':
            cursor.execute(f"SET IDENTITY_INSERT {table_name} OFF")
            
        print(f"    [OK] Import thành công {len(data_to_insert)} dòng vào {table_name}.")
        
    except Exception as e:
        print(f"    [LỖI] Tại bảng {table_name}: {e}")
        # In mẫu dữ liệu lỗi để debug
        # print("    Mẫu dữ liệu dòng đầu:", data_to_insert[0])
        raise e

# ================= 4. MAIN =================
def main():
    conn = None
    try:
        conn = get_connection()
        cursor = conn.cursor()
        
        tables_data = parse_mixed_csv(CSV_FILE_PATH)
        if not tables_data:
            return

        for table_name in TABLE_ORDER:
            if table_name in tables_data:
                clean_and_import(table_name, tables_data[table_name], cursor)
            else:
                print(f"[Info] Không có dữ liệu cho bảng {table_name}")
        
        conn.commit()
        print("\n=== HOÀN TẤT: THÀNH CÔNG 100% ===")
        
    except Exception as e:
        if conn: conn.rollback()
        print(f"\n[FATAL ERROR] Đã Rollback. Lỗi: {e}")
    finally:
        if conn: conn.close()

if __name__ == "__main__":
    main()
